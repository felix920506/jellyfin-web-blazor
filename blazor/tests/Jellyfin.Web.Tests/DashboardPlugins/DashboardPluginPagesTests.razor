@using Jellyfin.Web.Components
@using Jellyfin.Web.Pages.Dashboard.Plugins
@using Jellyfin.Web.Services
@using Jellyfin.Web.Tests.Dashboard
@using Jellyfin.Web.Tests.Session
@using Jellyfin.Web.Tests.Support
@using Microsoft.AspNetCore.Components.Web
@using Microsoft.JSInterop
@using Microsoft.Extensions.DependencyInjection
@inherits DashboardTestContext

@code {
    private const string Id = "11111111111111111111111111111111";
    private const string OtherId = "22222222222222222222222222222222";
    private void Script()
    {
        SignIn(admin: true);
        App.Server.OnGet("/Plugins", new[] { new { Id, Name = "Installed plugin", Version = "1.0.0.0", Status = "Active", CanUninstall = true, HasImage = true } });
        App.Server.OnGet("/Packages", new object[]
        {
            new { guid = Id, name = "Installed plugin", category = "Music", versions = new[] { new { version = "1.0.0.0" } } },
            new { guid = OtherId, name = "Available plugin", category = "Community", imageUrl = "https://example.test/image.png", versions = new[] { new { version = "2.0.0.0" } } },
        });
        App.Server.OnGet("/web/ConfigurationPages", Array.Empty<object>());
    }

    [Fact]
    public void Installed_plugins_are_default_and_cards_link_to_details()
    {
        Script();
        var cut = Render<DashboardPluginsIndex>();
        cut.Eventually(() => Assert.Single(cut.FindAll(".jf-dashboard-plugin-card")));
        var card = cut.Find(".jf-dashboard-plugin-card");
        Assert.Contains("Installed plugin", card.TextContent, StringComparison.Ordinal);
        Assert.Contains("Active", card.TextContent, StringComparison.Ordinal);
        Assert.Equal($"#/dashboard/plugins/{Id}?name=Installed%20plugin", card.GetAttribute("href"));
        Assert.Contains($"Plugins/{Id}/1.0.0.0/Image", card.QuerySelector("img")!.GetAttribute("src"), StringComparison.Ordinal);
    }

    [Theory]
    [InlineData("All", null, null, 2)]
    [InlineData("Available", null, null, 1)]
    [InlineData("All", "other", null, 1)]
    [InlineData("All", "music", "INSTALLED", 1)]
    [InlineData("All", null, "absent", 0)]
    public void Query_filters_are_applied(string status, string? category, string? query, int count)
    {
        Script();
        var cut = Render<DashboardPluginsIndex>(p => p.Add(c => c.Status, status).Add(c => c.Category, category).Add(c => c.Query, query));
        cut.Eventually(() => Assert.Equal(count, cut.FindAll(".jf-dashboard-plugin-card").Count));
        if (count == 0) cut.Eventually(() => Assert.Contains(Get<Globalize>().Translate("SearchResultsEmpty", "absent"), cut.Markup, StringComparison.Ordinal));
    }

    [Theory]
    [InlineData("/Plugins")]
    [InlineData("/Packages")]
    [InlineData("/web/ConfigurationPages")]
    public void Every_catalog_source_failure_shows_the_original_error(string path)
    {
        Script();
        App.Server.On(HttpMethod.Get, path, _ => FakeHttp.Status(System.Net.HttpStatusCode.InternalServerError));
        var cut = Render<DashboardPluginsIndex>();
        cut.Eventually(() => Assert.Contains(this.T("PluginsLoadError"), cut.Find(".mud-alert").TextContent, StringComparison.Ordinal));
        Assert.Empty(cut.FindAll(".jf-dashboard-plugin-card"));
    }

    [Fact]
    public async Task Filters_and_search_update_url_without_dropping_other_filters()
    {
        Script();
        Get<AppRouter>().Start();
        var cut = RenderAt<DashboardPluginsIndex>("/dashboard/plugins?category=music&query=abc");
        cut.Eventually(() => Assert.NotEmpty(cut.FindAll("[data-status]")));
        await cut.Find("[data-status=All]").ClickAsync(new MouseEventArgs());
        Assert.Equal("All", Get<AppRouter>().Location["status"]);
        Assert.Equal("music", Get<AppRouter>().Location["category"]);
        await cut.Find("#jf-dashboard-plugin-search").InputAsync(new ChangeEventArgs { Value = "new search" });
        Assert.Equal("new search", Get<AppRouter>().Location["query"]);
    }

    [Fact]
    public void Catalog_alias_replaces_the_location()
    {
        SignIn(admin: true);
        Get<AppRouter>().Start();
        Render<DashboardPluginCatalog>();
        Assert.Equal("/dashboard/plugins", Get<AppRouter>().Location.Path);
    }

    [Fact]
    public void Drawer_supports_multiple_main_menu_pages_from_one_plugin()
    {
        Script();
        App.Server.OnGet("/System/Info", new { ServerName = "Test" });
        App.Server.OnGet("/web/ConfigurationPages", new[]
        {
            new { PluginId = Id, Name = "first", DisplayName = "First page", EnableInMainMenu = true },
            new { PluginId = Id, Name = "second", DisplayName = "Second page", EnableInMainMenu = true },
        });
        var cut = Render<DashboardDrawerContent>();
        cut.Eventually(() => Assert.Single(cut.FindAll("a[href='#/configurationpage?name=second']")));
        Assert.Single(cut.FindAll("a[href='#/configurationpage?name=first']"));
    }

    [Fact]
    public async Task Configuration_passes_authenticated_resource_to_isolated_host()
    {
        Script();
        var module = JSInterop.SetupModule("./js/plugincompat.js");
        var session = module.SetupModule("mount", _ => true);
        session.SetupVoid("dispose").SetVoidResult();
        App.Server.OnGet("/web/ConfigurationPages", new[] { new { Name = "plugin settings", DisplayName = "My Settings", PluginId = Id } });
        App.Server.On(HttpMethod.Get, "/web/configurationpage", _ => PlainText("<script>dangerous()</script><h1>legacy content</h1>"));
        var cut = Render<DashboardPluginConfiguration>(p => p.Add(c => c.Name, "plugin settings"));
        cut.Eventually(() => Assert.Single(module.Invocations["mount"]));
        Assert.Contains("My Settings", cut.Markup, StringComparison.Ordinal);
        Assert.DoesNotContain("dangerous", cut.Markup, StringComparison.Ordinal);
        var request = Assert.Single(App.Server.RequestsTo("/web/configurationpage"));
        Assert.Equal("plugin settings", request.Query("name"));
        Assert.Contains("Token=", request.Headers["Authorization"], StringComparison.Ordinal);
        Assert.Equal("<script>dangerous()</script><h1>legacy content</h1>", module.Invocations["mount"][0].Arguments[1]);
        await cut.InvokeAsync(() => cut.Instance.DisposeAsync().AsTask());
        Assert.Single(session.Invocations["dispose"]);
    }

    [Fact]
    public async Task Configuration_query_change_disposes_old_document_and_mounts_new_one()
    {
        Script();
        var module = JSInterop.SetupModule("./js/plugincompat.js");
        var session = module.SetupModule("mount", _ => true);
        session.SetupVoid("dispose").SetVoidResult();
        App.Server.OnGet("/web/ConfigurationPages", new[] { new { Name = "one" }, new { Name = "two" } });
        App.Server.On(HttpMethod.Get, "/web/configurationpage", request => PlainText(request.Query("name")!));
        var cut = Render<DashboardPluginConfiguration>(p => p.Add(c => c.Name, "one"));
        cut.Eventually(() => Assert.Single(module.Invocations["mount"]));
        await cut.InvokeAsync(() => cut.Render(p => p.Add(c => c.Name, "two")));
        cut.Eventually(() => Assert.Equal(2, module.Invocations["mount"].Count));
        Assert.Single(session.Invocations["dispose"]);
        Assert.Equal("two", module.Invocations["mount"][1].Arguments[1]);
    }

    [Fact]
    public async Task Configuration_interop_failure_is_a_page_error_not_an_app_error()
    {
        await using var context = new BunitContext();
        var app = new TestApp();
        app.Configure(context.Services);
        context.Services.AddSingleton<IPluginConfigurationInterop>(new FailingPluginInterop());
        context.JSInterop.Mode = JSRuntimeMode.Loose;
        await app.LoadAssetsAsync(context.Services);
        app.SignIn(admin: true, services: context.Services);
        app.Server.OnGet("/web/ConfigurationPages", new[] { new { Name = "settings" } });
        app.Server.On(HttpMethod.Get, "/web/configurationpage", _ => PlainText("plugin"));
        var cut = context.Render<DashboardPluginConfiguration>(p => p.Add(c => c.Name, "settings"));
        cut.Eventually(() => Assert.Contains(this.T("PluginLoadConfigError"), cut.Find(".mud-alert").TextContent, StringComparison.Ordinal));
    }

    private sealed class FailingPluginInterop : IPluginConfigurationInterop
    {
        public ValueTask<IJSObjectReference> MountAsync(ElementReference host, string html, string name) =>
            ValueTask.FromException<IJSObjectReference>(new JSException("host failed"));
    }

    [Fact]
    public void Configuration_missing_page_has_no_configuration_notice()
    {
        Script();
        var cut = Render<DashboardPluginConfiguration>(p => p.Add(c => c.Name, "missing"));
        cut.Eventually(() => Assert.Contains(this.T("MessageNoPluginConfiguration"), cut.Markup, StringComparison.Ordinal));
        Assert.Empty(App.Server.RequestsTo("/web/configurationpage"));
    }

    [Theory]
    [InlineData(true)]
    [InlineData(false)]
    public void Configuration_list_and_resource_failures_are_visible(bool listFails)
    {
        Script();
        if (listFails) App.Server.On(HttpMethod.Get, "/web/ConfigurationPages", _ => FakeHttp.Status(System.Net.HttpStatusCode.InternalServerError));
        else App.Server.OnGet("/web/ConfigurationPages", new[] { new { Name = "settings", PluginId = Id } });
        var cut = Render<DashboardPluginConfiguration>(p => p.Add(c => c.Name, "settings"));
        cut.Eventually(() => Assert.Contains(this.T("PluginLoadConfigError"), cut.Markup, StringComparison.Ordinal));
    }
}
