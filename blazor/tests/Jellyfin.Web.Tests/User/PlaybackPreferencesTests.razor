    [Fact]
    public async Task Saving_stores_every_setting_where_the_original_does()
    {
        await this.UseConfigAsync(new { plugins = new[] { PlaybackOptions.StillWatchingPlugin } });
        ScriptSignedInUser();
        var cut = RenderLoaded();
        cut.Eventually(() => Assert.Equal(4, cut.FindAll("#selectAudioLanguage option").Count));

        cut.Find("#selectAllowedAudioChannels").Change("2");
        cut.Find("#selectAudioLanguage").Change("ger");
        cut.Find("input.chkPlayDefaultAudioTrack").Change(true);
        cut.Find("input.chkDisableVbrAudioEncoding").Change(true);
        cut.Find("select.selectVideoInNetworkQuality").Change("20000000");
        cut.Find("select.selectChromecastVideoQuality").Change("6000000");
        cut.Find("select.selectMaxVideoWidth").Change("1280");
        cut.Find("input.chkLimitSupportedVideoResolution").Change(true);
        cut.Find("input.chkPreferFmp4HlsContainer").Change(false);
        cut.Find("input.chkEnableCinemaMode").Change(false);
        cut.Find("input.chkEpisodeAutoPlay").Change(true);
        cut.Find("select.selectStillWatchingOption").Change("short");
        cut.Find("input.chkRememberAudioSelections").Change(true);
        cut.Find("input.chkRememberSubtitleSelections").Change(true);
        cut.Find("input.chkEnableNextVideoOverlay").Change(false);
        cut.Find("select.selectChromecastVersion").Change("6F511C87");
        cut.Find("select.selectSkipForwardLength").Change("20000");
        cut.Find("select.selectSkipBackLength").Change("15000");
        cut.Find("#segmentTypeAction__Intro").Change("Skip");
        cut.Find("#segmentTypeAction__Commercial").Change("AskToSkip");
        cut.Find("input.chkEnableDts").Change(true);
        cut.Find("input.chkEnableTrueHd").Change(true);
        cut.Find("#selectPreferredTranscodeVideoCodec").Change("av1");
        cut.Find("#selectPreferredTranscodeVideoAudioCodec").Change("flac");
        cut.Find("#selectAudioNormalization").Change("Off");
        cut.Find("input.chkAlwaysRemuxFlac").Change(true);
        cut.Find("input.chkAlwaysRemuxMp3").Change(true);
        await this.Settle(() => cut.Find("form").SubmitAsync());

        cut.Eventually(() => Assert.Equal([this.T("SettingsSaved")], this.Toasts()));
        Assert.False(this.IsLoading());

        // Settings of this device, for every user.
        Assert.Equal("false", this.AppSetting("enableSystemExternalPlayers"));
        Assert.Equal("6000000", this.AppSetting("chromecastBitrate1"));
        Assert.Equal("1280", this.AppSetting("maxVideoWidth"));
        Assert.Equal("true", this.AppSetting("limitSupportedVideoResolution"));
        Assert.Equal("av1", this.AppSetting("preferredTranscodeVideoCodec"));
        Assert.Equal("flac", this.AppSetting("preferredTranscodeVideoAudioCodec"));
        Assert.Equal("true", this.AppSetting("enableDts"));
        Assert.Equal("true", this.AppSetting("enableTrueHd"));
        Assert.Equal("false", this.AppSetting("enableHi10p"));
        Assert.Equal("true", this.AppSetting("disableVbrAudio"));
        Assert.Equal("true", this.AppSetting("alwaysRemuxFlac"));
        Assert.Equal("true", this.AppSetting("alwaysRemuxMp3"));
        Assert.Equal("20000000", this.AppSetting("maxbitrate-Video-true"));
        Assert.Equal("false", this.AppSetting("enableautobitratebitrate-Video-true"));
        Assert.Null(this.AppSetting("maxbitrate-Video-false"));
        Assert.Equal("true", this.AppSetting("enableautobitratebitrate-Video-false"));
        Assert.Null(this.AppSetting("maxbitrate-Audio-false"));
        Assert.Equal("true", this.AppSetting("enableautobitratebitrate-Audio-false"));

        // Settings of this device, for this user.
        Assert.Equal("2", this.UserSetting("allowedAudioChannels"));
        Assert.Equal("short", this.UserSetting("stillWatchingPrompt"));
        Assert.Equal("false", this.UserSetting("preferFmp4HlsContainer"));
        Assert.Equal("false", this.UserSetting("limitSegmentLength"));
        Assert.Equal("false", this.UserSetting("enableCinemaMode"));
        Assert.Equal("Off", this.UserSetting("selectAudioNormalization"));
        Assert.Equal("Skip", this.UserSetting("segmentTypeAction__Intro"));
        Assert.Equal("None", this.UserSetting("segmentTypeAction__Preview"));
        Assert.Equal("None", this.UserSetting("segmentTypeAction__Recap"));
        Assert.Equal("AskToSkip", this.UserSetting("segmentTypeAction__Commercial"));
        Assert.Equal("AskToSkip", this.UserSetting("segmentTypeAction__Outro"));

        // Settings that follow the user to other devices.
        cut.Eventually(() => Assert.NotNull(this.PostedPreferences()));
        var preferences = this.PostedPreferences()!.Value;
        Assert.Equal("20000", preferences.Text("skipForwardLength"));
        Assert.Equal("15000", preferences.Text("skipBackLength"));
        Assert.Equal("false", preferences.Text("enableNextVideoInfoOverlay"));
        Assert.Null(preferences.Text("allowedAudioChannels"));
        Assert.Null(preferences.Text("segmentTypeAction__Intro"));

        var request = this.PostedConfiguration();
        Assert.NotNull(request);
        Assert.True(request.QueryIs("userId", TestApp.UserId));
        var configuration = request.JsonBody();
        Assert.Equal("ger", configuration.Text("AudioLanguagePreference"));
        Assert.True(configuration.Flag("PlayDefaultAudioTrack"));
        Assert.True(configuration.Flag("EnableNextEpisodeAutoPlay"));
        Assert.True(configuration.Flag("RememberAudioSelections"));
        Assert.True(configuration.Flag("RememberSubtitleSelections"));
        Assert.Equal("6F511C87", configuration.Text("CastReceiverId"));
        // What the page does not edit is sent back as it was read.
        Assert.True(configuration.Flag("HidePlayedInLatest"));
        // The user is read again right before saving.
        Assert.Equal(2, this.UserLoads(TestApp.UserId).Count);
    }

    [Fact]
    public async Task Choosing_automatic_quality_turns_bitrate_detection_back_on()
    {
        this.StoreAppSetting("maxbitrate-Video-true", "8000000");
        this.StoreAppSetting("enableautobitratebitrate-Video-true", "false");
        ScriptSignedInUser();
        var cut = RenderLoaded();
        Assert.Equal("8000000", cut.Find("select.selectVideoInNetworkQuality").Value());

        cut.Find("select.selectVideoInNetworkQuality").Change(string.Empty);
        await this.Settle(() => cut.Find("form").SubmitAsync());

        cut.Eventually(() => Assert.Single(this.Toasts()));
        Assert.Equal("true", this.AppSetting("enableautobitratebitrate-Video-true"));
        // The bitrate itself is kept, as in the original.
        Assert.Equal("8000000", this.AppSetting("maxbitrate-Video-true"));
    }

    [Fact]
    public async Task An_administrator_edits_the_settings_of_another_user()
    {
        SignIn(admin: true);
        this.ScriptUser(Other, UserJson(Other));
        ScriptServer();
        var cut = RenderLoaded(Other.ToString("N"));

        // Streaming quality belongs to the device of the signed-in user.
        Assert.True(Hidden(cut, ".qualitySections"));
        Assert.True(App.Server.RequestsTo("/DisplayPreferences/usersettings")[^1].QueryIs("userId", Other));

        cut.Find("#selectAllowedAudioChannels").Change("8");
        cut.Find("input.chkPlayDefaultAudioTrack").Change(true);
        cut.Find("select.selectSkipBackLength").Change("5000");
        await this.Settle(() => cut.Find("form").SubmitAsync());

        cut.Eventually(() => Assert.Equal([this.T("SettingsSaved")], this.Toasts()));
        var request = this.PostedConfiguration();
        Assert.NotNull(request);
        Assert.True(request.QueryIs("userId", Other));
        Assert.True(request.JsonBody().Flag("PlayDefaultAudioTrack"));
        Assert.Equal("8", this.UserSetting("allowedAudioChannels", Other));
        Assert.Null(this.UserSetting("allowedAudioChannels"));
        Assert.Equal(2, this.UserLoads(Other).Count);
        Assert.Empty(this.UserLoads(TestApp.UserId));

        cut.Eventually(() => Assert.NotNull(this.PostedPreferences()));
        Assert.Equal("5000", this.PostedPreferences()!.Value.Text("skipBackLength"));
        var posted = App.Server.Requests.Last(r => r.Method == HttpMethod.Post && r.Path.EndsWith("/DisplayPreferences/usersettings", StringComparison.OrdinalIgnoreCase));
        Assert.True(posted.QueryIs("userId", Other));
    }

