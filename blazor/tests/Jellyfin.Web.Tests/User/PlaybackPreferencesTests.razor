    [Fact]
    public async Task Saving_without_the_user_keeps_the_page_busy()
    {
        ScriptSignedInUser();
        var cut = RenderLoaded();
        App.Server.On(HttpMethod.Get, "/Users/" + TestApp.UserId.ToString("N"), _ => FakeHttp.Status(HttpStatusCode.InternalServerError));
        App.Server.On(HttpMethod.Get, "/Users/" + TestApp.UserId.ToString("D"), _ => FakeHttp.Status(HttpStatusCode.InternalServerError));

        await this.Settle(() => cut.Find("form").SubmitAsync());

        cut.Eventually(() => Assert.Equal(2, this.UserLoads(TestApp.UserId).Count));
        Assert.True(this.IsLoading());
        Assert.Empty(this.Toasts());
        Assert.Null(this.PostedConfiguration());
    }

    [Fact]
    public void Without_the_user_the_form_stays_empty_and_busy()
    {
        SignIn();
        ScriptServer();

        // GET Users/{id} is not scripted and fails.
        var cut = Render<PlaybackPreferences>();

        cut.Eventually(() => Assert.Single(this.UserLoads(TestApp.UserId)));
        Assert.Empty(cut.FindAll("select.segmentTypeAction"));
        Assert.True(this.IsLoading());
        Assert.Empty(App.Server.RequestsTo("/System/Endpoint"));
    }

