@* Quick Connect authorisation (/quickconnect). *@
@using System.Net
@using Jellyfin.Web
@using Jellyfin.Web.Pages.User
@using Jellyfin.Web.Services
@using Jellyfin.Web.Tests.Session
@using Jellyfin.Web.Tests.Support
@using Microsoft.Extensions.DependencyInjection
@inherits AppTestContext

@code {
    private static readonly Guid Other = SettingsTestExtensions.OtherUserId;
    private static readonly Guid Disabled = Guid.Parse("99999999-8888-7777-6666-555555555555");

    private void ScriptUsers() => App.Server.OnGet("/Users", new[]
    {
        new { Id = TestApp.UserId, Name = "tester", Policy = new { IsDisabled = false } },
        new { Id = Other, Name = "guest", Policy = new { IsDisabled = false } },
        new { Id = Disabled, Name = "gone", Policy = new { IsDisabled = true } }
    });

    private IRenderedComponent<QuickConnectPage> RenderPage(string? userId = null, string? code = null)
    {
        var cut = Render<QuickConnectPage>(parameters => parameters
            .Add(page => page.UserId, userId)
            .Add(page => page.Code, code));
        cut.Eventually(() => Assert.NotNull(cut.Find("#quickConnectPreferencesPage")));
        return cut;
    }

    private IReadOnlyList<RecordedRequest> Authorizations => App.Server.RequestsTo("/QuickConnect/Authorize");

    [Fact]
    public void Users_enter_a_code_for_themselves()
    {
        SignIn();
        ScriptUsers();

        var cut = RenderPage();

        Assert.Empty(cut.FindAll("#userId"));
        var code = cut.Find("#txtQuickConnectCode");
        Assert.True(code.HasAttribute("required"));
        Assert.Equal("numeric", code.GetAttribute("inputmode"));
        Assert.Equal("[0-9\\s]*", code.GetAttribute("pattern"));
        Assert.Equal("6", code.GetAttribute("minlength"));
        Assert.Equal(this.T("QuickConnect"), cut.Find("h2.sectionTitle").TextContent);
        Assert.Contains(this.T("QuickConnectDescription"), cut.Find(".verticalSection").TextContent, StringComparison.Ordinal);
        Assert.Equal(this.T("Authorize"), cut.Find("button[type=submit]").TextContent.Trim());
        Assert.Empty(cut.FindAll(".quickConnectError"));
        Assert.False(this.IsLoading());
    }

    [Fact]
    public void Administrators_choose_the_user_among_the_enabled_ones()
    {
        SignIn(admin: true);
        ScriptUsers();

        var cut = RenderPage();

        Assert.Equal([TestApp.UserId.ToString("N"), Other.ToString("N")], cut.FindAll("#userId option").Select(option => option.Value()));
        Assert.Equal(["tester", "guest"], cut.FindAll("#userId option").Select(option => option.TextContent));
        Assert.Equal(TestApp.UserId.ToString("N"), cut.Find("#userId").Value());
    }

    [Fact]
    public void The_user_and_code_of_the_link_are_preselected()
    {
        SignIn(admin: true);
        ScriptUsers();

        var cut = RenderPage(userId: Other.ToString("N"), code: "123456");

        Assert.Equal(Other.ToString("N"), cut.Find("#userId").Value());
        Assert.Equal("123456", cut.Find("#txtQuickConnectCode").Value());
    }

    [Fact]
    public void A_user_missing_from_the_list_falls_back_to_the_first_one()
    {
        SignIn(admin: true);
        ScriptUsers();

        var cut = RenderPage(userId: Disabled.ToString("N"));

        Assert.Equal(TestApp.UserId.ToString("N"), cut.Find("#userId").Value());
    }

    [Fact]
    public async Task A_code_is_authorized_without_its_spaces()
    {
        SignIn();
        ScriptUsers();
        App.Server.OnPost("/QuickConnect/Authorize", "true");
        var cut = RenderPage();

        cut.Find("#txtQuickConnectCode").Input("123 456");
        await this.Settle(() => cut.Find("form").SubmitAsync());

        cut.Eventually(() => Assert.Contains(this.T("QuickConnectAuthorizeSuccess"), cut.Markup, StringComparison.Ordinal));
        var request = Assert.Single(Authorizations);
        Assert.Equal("123456", request.Query("code"));
        // Only administrators name a user; the server uses the signed-in one otherwise.
        Assert.Null(request.Query("userId"));
        Assert.Equal("#/home", cut.Find("a.button-link").GetAttribute("href"));
        Assert.Equal(this.T("GoHome"), cut.Find("a.button-link").TextContent);
        Assert.Empty(cut.FindAll("#txtQuickConnectCode"));
        Assert.Empty(cut.FindAll(".quickConnectError"));
    }

    [Fact]
    public async Task Administrators_authorize_for_the_selected_user()
    {
        SignIn(admin: true);
        ScriptUsers();
        App.Server.OnPost("/QuickConnect/Authorize", "true");
        var cut = RenderPage();

        cut.Find("#userId").Change(Other.ToString("N"));
        cut.Find("#txtQuickConnectCode").Input("654321");
        await this.Settle(() => cut.Find("form").SubmitAsync());

        cut.Eventually(() => Assert.Single(Authorizations));
        Assert.Equal("654321", Authorizations[0].Query("code"));
        Assert.True(Authorizations[0].QueryIs("userId", Other));
    }

    [Theory]
    [InlineData("")]
    [InlineData("12345")]
    [InlineData("12a456")]
    public async Task An_invalid_code_is_not_sent(string code)
    {
        SignIn();
        ScriptUsers();
        App.Server.OnPost("/QuickConnect/Authorize", "true");
        var cut = RenderPage();

        cut.Find("#txtQuickConnectCode").Input(code);
        await this.Settle(() => cut.Find("form").SubmitAsync());

        Assert.Equal(this.T("QuickConnectInvalidCode"), cut.Find(".quickConnectError").TextContent);
        Assert.Empty(Authorizations);
    }

    [Fact]
    public async Task A_rejected_code_is_reported_and_can_be_corrected()
    {
        SignIn();
        ScriptUsers();
        App.Server.OnPost("/QuickConnect/Authorize", _ => FakeHttp.Status(HttpStatusCode.NotFound));
        var cut = RenderPage();

        cut.Find("#txtQuickConnectCode").Input("111111");
        await this.Settle(() => cut.Find("form").SubmitAsync());

        cut.Eventually(() => Assert.Equal(this.T("QuickConnectAuthorizeFail"), cut.Find(".quickConnectError").TextContent));
        Assert.NotNull(cut.Find("#txtQuickConnectCode"));

        App.Server.OnPost("/QuickConnect/Authorize", "true");
        cut.Find("#txtQuickConnectCode").Input("222222");
        await this.Settle(() => cut.Find("form").SubmitAsync());

        cut.Eventually(() => Assert.Contains(this.T("QuickConnectAuthorizeSuccess"), cut.Markup, StringComparison.Ordinal));
        Assert.Empty(cut.FindAll(".quickConnectError"));
        Assert.Equal(["111111", "222222"], Authorizations.Select(request => request.Query("code")));
    }

    [Fact]
    public void Without_the_user_list_the_form_still_works()
    {
        SignIn();

        // GET Users is not scripted and fails.
        var cut = RenderPage();

        Assert.NotNull(cut.Find("#txtQuickConnectCode"));
        Assert.False(this.IsLoading());
    }

    [Theory]
    [InlineData("123456", true)]
    [InlineData("123 456", true)]
    [InlineData(" 12345", true)]
    [InlineData("1234567890", true)]
    [InlineData("12345", false)]
    [InlineData("", false)]
    [InlineData(null, false)]
    [InlineData("abcdef", false)]
    [InlineData("12345-", false)]
    [InlineData("１２３４５６", false)]
    public void Codes_are_digits_and_spaces_of_at_least_six_characters(string? code, bool valid) =>
        Assert.Equal(valid, QuickConnectPage.IsValidCode(code));
}
