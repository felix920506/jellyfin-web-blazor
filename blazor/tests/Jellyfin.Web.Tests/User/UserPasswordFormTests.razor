@* The password section of the profile page. *@
@using System.Net
@using Jellyfin.Sdk.Generated.Models
@using Jellyfin.Web
@using Jellyfin.Web.Pages.User
@using Jellyfin.Web.Services
@using Jellyfin.Web.Tests.Session
@using Jellyfin.Web.Tests.Support
@using Microsoft.AspNetCore.Components.Web
@using Microsoft.Extensions.DependencyInjection
@inherits AppTestContext

@code {
    private static readonly Guid Other = SettingsTestExtensions.OtherUserId;

    private static UserDto Guest(bool admin = false, bool preferenceAccess = true) => new()
    {
        Id = Other,
        Name = "guest",
        Policy = new UserPolicy { IsAdministrator = admin, EnableUserPreferenceAccess = preferenceAccess }
    };

    private IRenderedComponent<UserPasswordForm> RenderForm(UserDto user) =>
        Render<UserPasswordForm>(parameters => parameters.Add(form => form.User, user));

    private static void Fill(IRenderedComponent<UserPasswordForm> cut, string current, string password, string confirmation)
    {
        cut.Find("#txtCurrentPassword").Input(current);
        cut.Find("#txtNewPassword").Input(password);
        cut.Find("#txtNewPasswordConfirm").Input(confirmation);
    }

    private IReadOnlyList<RecordedRequest> PasswordRequests => App.Server.RequestsTo("/Users/Password");

    [Fact]
    public void The_form_is_rendered_like_the_original()
    {
        SignIn(admin: true);

        var cut = RenderForm(Guest());

        var form = cut.Find("form.updatePasswordForm.passwordSection");
        Assert.False(form.HasClass("hide"));
        Assert.Equal(
            [this.T("LabelCurrentPassword"), this.T("LabelNewPassword"), this.T("LabelNewPasswordConfirm")],
            cut.FindAll("label").Select(label => label.TextContent.Trim()));
        Assert.All(
            new[] { "#txtCurrentPassword", "#txtNewPassword", "#txtNewPasswordConfirm" },
            selector => Assert.Equal("password", cut.Find(selector).GetAttribute("type")));
        Assert.Equal(this.T("SavePassword"), cut.Find("button[type=submit]").TextContent.Trim());
        Assert.Equal(this.T("ResetPassword"), cut.Find("#btnResetPassword").TextContent.Trim());
        Assert.False(cut.Find("#btnResetPassword").HasClass("hide"));
    }

    [Fact]
    public void Users_without_preference_access_cannot_change_their_password()
    {
        var me = App.SignIn(services: Services, configure: user => user.Policy!.EnableUserPreferenceAccess = false);

        var cut = RenderForm(me);

        Assert.True(cut.Find("form.updatePasswordForm").HasClass("hide"));
    }

    [Fact]
    public void Users_with_preference_access_can_change_their_password()
    {
        var me = App.SignIn(services: Services, configure: user => user.Policy!.EnableUserPreferenceAccess = true);

        var cut = RenderForm(me);

        Assert.False(cut.Find("form.updatePasswordForm").HasClass("hide"));
    }

    [Fact]
    public void Administrators_have_no_reset_button()
    {
        SignIn(admin: true);

        var cut = RenderForm(Guest(admin: true));

        Assert.True(cut.Find("#btnResetPassword").HasClass("hide"));
    }

    [Fact]
    public async Task A_new_password_is_posted_with_the_current_one()
    {
        SignIn(admin: true);
        App.Server.OnPost("/Users/Password");
        var cut = RenderForm(Guest());
        Fill(cut, "old", "new secret", "new secret");

        await this.Settle(() => cut.Find("form.updatePasswordForm").SubmitAsync());

        cut.Eventually(() => Assert.Contains(this.T("PasswordSaved"), this.Toasts()));
        var request = Assert.Single(PasswordRequests);
        Assert.True(request.QueryIs("userId", Other));
        var body = request.JsonBody();
        Assert.Equal("old", body.Text("CurrentPw"));
        Assert.Equal("new secret", body.Text("NewPw"));
        Assert.Null(body.Flag("ResetPassword"));
        // The fields are emptied.
        Assert.All(
            new[] { "#txtCurrentPassword", "#txtNewPassword", "#txtNewPasswordConfirm" },
            selector => Assert.True(string.IsNullOrEmpty(cut.Find(selector).Value())));
        Assert.False(this.IsLoading());
    }

    [Fact]
    public async Task Passwords_that_differ_are_not_sent()
    {
        SignIn(admin: true);
        App.Server.OnPost("/Users/Password");
        var cut = RenderForm(Guest());
        Fill(cut, "old", "one", "two");

        await this.Settle(() => cut.Find("form.updatePasswordForm").SubmitAsync());

        Assert.Equal([this.T("PasswordMatchError")], this.Toasts());
        Assert.Empty(PasswordRequests);
    }

    [Fact]
    public async Task An_administrator_cannot_get_an_empty_password()
    {
        SignIn(admin: true);
        App.Server.OnPost("/Users/Password");
        var cut = RenderForm(Guest(admin: true));
        cut.Find("#txtCurrentPassword").Input("old");

        await this.Settle(() => cut.Find("form.updatePasswordForm").SubmitAsync());

        Assert.Equal([this.T("PasswordMissingSaveError")], this.Toasts());
        Assert.Empty(PasswordRequests);
    }

    [Fact]
    public async Task Other_users_may_get_an_empty_password()
    {
        SignIn(admin: true);
        App.Server.OnPost("/Users/Password");
        var cut = RenderForm(Guest());

        await this.Settle(() => cut.Find("form.updatePasswordForm").SubmitAsync());

        cut.Eventually(() => Assert.Contains(this.T("PasswordSaved"), this.Toasts()));
        var body = Assert.Single(PasswordRequests).JsonBody();
        Assert.Equal(string.Empty, body.Text("NewPw"));
        Assert.Equal(string.Empty, body.Text("CurrentPw"));
    }

    [Fact]
    public async Task A_rejected_password_is_reported_and_the_fields_are_kept()
    {
        SignIn(admin: true);
        App.Server.OnPost("/Users/Password", _ => FakeHttp.Status(HttpStatusCode.Forbidden));
        var cut = RenderForm(Guest());
        var dialogs = this.RenderDialogs();
        Fill(cut, "wrong", "new", "new");

        await this.Settle(() => cut.Find("form.updatePasswordForm").SubmitAsync());

        dialogs.Eventually(() => Assert.Equal(this.T("HeaderLoginFailure"), dialogs.Find(".formDialogHeaderTitle").TextContent));
        Assert.Equal(this.T("MessageInvalidUser"), dialogs.Find(".text").TextContent);
        Assert.Empty(this.Toasts());
        Assert.Equal("new", cut.Find("#txtNewPassword").Value());
        Assert.False(this.IsLoading());
    }

    [Fact]
    public async Task Resetting_the_password_asks_first()
    {
        SignIn(admin: true);
        App.Server.OnPost("/Users/Password");
        var cut = RenderForm(Guest());
        var dialogs = this.RenderDialogs();
        Fill(cut, "old", "new", "new");

        await this.Settle(() => cut.Find("#btnResetPassword").ClickAsync(new MouseEventArgs()));

        dialogs.Eventually(() => Assert.Equal(this.T("ResetPassword"), dialogs.Find(".formDialogHeaderTitle").TextContent));
        Assert.Equal(this.T("PasswordResetConfirmation"), dialogs.Find(".text").TextContent);
        Assert.Empty(PasswordRequests);

        await this.Settle(() => dialogs.Find("button.btnOption[data-id=ok]").ClickAsync(new MouseEventArgs()));

        dialogs.Eventually(() => Assert.Equal(this.T("PasswordResetComplete"), dialogs.Find(".text").TextContent));
        Assert.Equal(this.T("ResetPassword"), dialogs.Find(".formDialogHeaderTitle").TextContent);
        var request = Assert.Single(PasswordRequests);
        Assert.True(request.QueryIs("userId", Other));
        Assert.True(request.JsonBody().Flag("ResetPassword"));
        Assert.Null(request.JsonBody().Text("NewPw"));
        cut.Eventually(() => Assert.True(string.IsNullOrEmpty(cut.Find("#txtNewPassword").Value())));
        Assert.False(this.IsLoading());
    }

    [Fact]
    public async Task Declining_the_reset_changes_nothing()
    {
        SignIn(admin: true);
        App.Server.OnPost("/Users/Password");
        var cut = RenderForm(Guest());
        var dialogs = this.RenderDialogs();

        await this.Settle(() => cut.Find("#btnResetPassword").ClickAsync(new MouseEventArgs()));
        dialogs.Eventually(() => Assert.NotNull(dialogs.Find("button.btnOption[data-id=cancel]")));
        await this.Settle(() => dialogs.Find("button.btnOption[data-id=cancel]").ClickAsync(new MouseEventArgs()));

        dialogs.Eventually(() => Assert.Empty(dialogs.FindAll(".dialog")));
        Assert.Empty(PasswordRequests);
    }

    [Fact]
    public async Task A_failed_reset_shows_no_confirmation()
    {
        SignIn(admin: true);
        App.Server.OnPost("/Users/Password", _ => FakeHttp.Status(HttpStatusCode.InternalServerError));
        var cut = RenderForm(Guest());
        var dialogs = this.RenderDialogs();

        await this.Settle(() => cut.Find("#btnResetPassword").ClickAsync(new MouseEventArgs()));
        dialogs.Eventually(() => Assert.NotNull(dialogs.Find("button.btnOption[data-id=ok]")));
        await this.Settle(() => dialogs.Find("button.btnOption[data-id=ok]").ClickAsync(new MouseEventArgs()));

        cut.Eventually(() => Assert.Single(PasswordRequests));
        cut.Eventually(() => Assert.False(this.IsLoading()));
        dialogs.Eventually(() => Assert.Empty(dialogs.FindAll(".dialog")));
    }
}
