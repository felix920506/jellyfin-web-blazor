    [Fact]
    public void An_item_this_client_cannot_play_has_no_play_button()
    {
        Playback.Playable = false;

        var cut = RenderMovie();

        Assert.Equal(["btnPlayTrailer", "btnPlaystate", "btnUserRating", "btnMoreCommands"], VisibleButtons(cut));
        Assert.True(Hidden(cut.Find("form.trackSelections")));
    }

    [Fact]
    public void A_started_movie_resumes_or_starts_over()
    {
        var cut = RenderMovie(position: 30 * Minute);

        Assert.Equal("Resume", cut.Find(".btnPlay").GetAttribute("title"));
        Assert.False(Hidden(cut.Find(".btnReplay")));
        Assert.Equal("Play", cut.Find(".btnReplay").GetAttribute("title"));

        cut.Find(".btnPlay").Click();
        cut.Find(".btnReplay").Click();

        cut.WaitForAssertion(() => Assert.Equal(2, Playback.PlayRequests.Count));
        Assert.Equal(30 * Minute, Playback.PlayRequests[0].StartPositionTicks);
        Assert.Equal(0, Playback.PlayRequests[1].StartPositionTicks);
        Assert.Equal(MovieId, Assert.Single(Playback.PlayRequests[0].Items!).IdText());
    }

    [Fact]
    public void The_trailer_button_plays_the_trailers()
    {
        var cut = RenderMovie();

        cut.Find(".btnPlayTrailer").Click();

        cut.WaitForAssertion(() => Assert.Contains("PlayTrailers", Playback.Calls));
    }

    [Fact]
    public void Played_and_favorite_are_set_on_the_server()
    {
        App.Server.OnPost("/UserPlayedItems/" + MovieId, UserData(MovieId, played: true));
        App.Server.OnPost("/UserFavoriteItems/" + MovieId, UserData(MovieId, played: true, favorite: true));
        var cut = RenderMovie();
        Assert.Equal("false", cut.Find(".btnPlaystate").GetAttribute("data-played"));

        cut.Find(".btnPlaystate").Click();
        cut.WaitForAssertion(() => Assert.Equal("true", cut.Find(".btnPlaystate").GetAttribute("data-played")));
        cut.Find(".btnUserRating").Click();
        cut.WaitForAssertion(() => Assert.Equal("true", cut.Find(".btnUserRating").GetAttribute("data-isfavorite")));

        Assert.Single(App.Server.RequestsTo("/UserPlayedItems/" + MovieId));
        Assert.Single(App.Server.RequestsTo("/UserFavoriteItems/" + MovieId));
    }

