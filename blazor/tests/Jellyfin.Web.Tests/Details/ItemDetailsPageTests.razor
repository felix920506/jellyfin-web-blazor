    private static object Items(params object[] items) => new { Items = items, TotalRecordCount = items.Length };

    private IRenderedComponent<ContainerFragment> RenderDetails(
        string? id,
        string? context = null,
        string? musicArtist = null,
        string? genre = null,
        string? musicGenre = null,
        string? seriesTimerId = null)
    {
        _id = id;
        _context = context;
        _musicArtist = musicArtist;
        _genre = genre;
        _musicGenre = musicGenre;
        _seriesTimerId = seriesTimerId;
        var query = new (string Key, string? Value)[]
            {
                ("id", id), ("context", context), ("musicartist", musicArtist), ("genre", genre), ("musicgenre", musicGenre),
                ("seriesTimerId", seriesTimerId), ("serverId", TestApp.ServerId)
            }
            .Where(pair => pair.Value is not null)
            .Select(pair => pair.Key + "=" + Uri.EscapeDataString(pair.Value!));
        _location = AppLocation.Parse("/details?" + string.Join('&', query));
        return Render(
            @<CascadingValue Value="_location">
                <ItemDetails Id="@_id" ServerId="@TestApp.ServerId" Context="@_context" MusicArtist="@_musicArtist"
                             Genre="@_genre" MusicGenre="@_musicGenre" SeriesTimerId="@_seriesTimerId" />
            </CascadingValue>);
    }

    private IRenderedComponent<ContainerFragment> RenderMovie(long position = 0, Action<Dictionary<string, object?>>? change = null)
    {
        var movie = Movie(position);
        change?.Invoke(movie);
        App.Server.OnGet("/Items/" + MovieId, movie);
        var cut = RenderDetails(MovieId);
        cut.WaitForAssertion(() => Assert.Equal("Second Feature", cut.Find("h1.itemName").TextContent));
        return cut;
    }

    private static bool Hidden(AngleSharp.Dom.IElement element) => element.ClassList.Contains("hide");

    private static string[] VisibleButtons(IRenderedComponent<ContainerFragment> cut) => cut.FindAll(".mainDetailButtons > button")
        .Where(button => !Hidden(button))
        .Select(button => button.ClassList.First(name => name.StartsWith("btn", StringComparison.Ordinal)))
        .ToArray();

    private static string[] Texts(IRenderedComponent<ContainerFragment> cut, string selector) =>
        cut.FindAll(selector).Select(element => element.TextContent.Trim()).ToArray();

    // --- Movie: header ----------------------------------------------------------------------------

    [Fact]
    public void A_movie_shows_its_header()
    {
        var cut = RenderMovie();

        Assert.Equal(
            "page libraryPage itemDetailPage noSecondaryNavPage selfBackdropPage noBackdropTransparency",
            cut.Find("#itemDetailPage").ClassName);
        Assert.Equal("Zweiter Film", cut.Find("h4.originalTitle").TextContent);

        // The poster is in the page twice: beside the title on desktop, above it on phones.
        Assert.Equal(2, cut.FindAll(".detailImageContainer .card.portraitCard").Count);
        Assert.Contains("hide-mobile", cut.FindAll(".detailImageContainer")[0].ClassName);
        Assert.Contains("hide-desktop", cut.FindAll(".detailImageContainer")[1].ClassName);

        Assert.Contains("2021", cut.Find(".itemMiscInfo-primary").TextContent);
        Assert.Equal("Twice as good", cut.Find("h3.tagline").TextContent);
        Assert.False(Hidden(cut.Find("h3.tagline")));
        Assert.Equal("Tags: feel good", cut.Find(".itemTags").TextContent);
        Assert.Equal("IMDb", cut.Find(".itemExternalLinks a").TextContent);
        Assert.Equal("_blank", cut.Find(".itemExternalLinks a").GetAttribute("target"));
        Assert.True(Hidden(cut.Find("#itemBirthday")));
        Assert.True(Hidden(cut.Find("#seriesAirTime")));

        // Directors, studios and genres with their links.
        Assert.Equal(["Director", "Studio", "Genre"], Texts(cut, ".itemDetailsGroup .detailsGroupItem .label"));
        Assert.Equal(["Dee Director", "Studio One", "Drama"], Texts(cut, ".itemDetailsGroup a"));
        Assert.Equal(
            $"#/list?genreId={TestItems.Id(71)}&serverId={TestApp.ServerId}",
            cut.FindAll(".itemDetailsGroup a")[2].GetAttribute("href"));
    }

    [Fact]
    public async Task The_banner_of_a_movie_is_the_page_backdrop_and_the_header_is_see_through()
    {
        var cut = RenderMovie();

        var backdrop = Assert.Single(BackdropDom.Shown);
        Assert.Contains($"/Items/{MovieId}/Images/Backdrop/0?", backdrop);
        Assert.Contains("tag=b1", backdrop);
        Assert.True(Get<ShellState>().TransparentHeader);

        var logo = cut.Find(".detailLogo");
        Assert.Contains("lazy", logo.ClassName);
        Assert.Contains($"/Items/{MovieId}/Images/Logo", logo.GetAttribute("data-src"));
        Assert.Equal("itemBackdrop", cut.Find("#itemBackdrop").ClassName);

        // Leaving the page takes the backdrop away and makes the header opaque again.
        await DisposeComponentsAsync();
        Assert.Null(BackdropDom.Url);
        Assert.False(Get<ShellState>().TransparentHeader);
    }

    [Fact]
    public void With_backdrops_turned_on_the_page_stays_see_through()
    {
        Get<UserSettings>().EnableBackdrops = true;

        var cut = RenderMovie();

        Assert.DoesNotContain("noBackdropTransparency", cut.Find("#itemDetailPage").ClassName);
        Assert.Single(BackdropDom.Shown);
    }

    [Fact]
    public void Without_the_banner_setting_there_is_no_backdrop()
    {
        Get<UserSettings>().DetailsBanner = false;

        var cut = RenderMovie();

        Assert.Empty(BackdropDom.Shown);
        Assert.DoesNotContain("noBackdropTransparency", cut.Find("#itemDetailPage").ClassName);
    }

    [Fact]
    public void On_a_phone_the_banner_sits_above_the_title()
    {
        Get<AppHost>().SetLayout("mobile");

        var cut = RenderMovie();

        var banner = cut.Find("#itemBackdrop");
        Assert.Equal("itemBackdrop lazy", banner.ClassName);
        Assert.Contains($"/Items/{MovieId}/Images/Backdrop/0?", banner.GetAttribute("data-src"));
        Assert.Empty(BackdropDom.Shown);
        Assert.False(Get<ShellState>().TransparentHeader);
