    // --- Movie: track selection -------------------------------------------------------------------

    [Fact]
    public void A_movie_offers_its_tracks()
    {
        var cut = RenderMovie();

        Assert.False(Hidden(cut.Find("form.trackSelections")));
        Assert.True(Hidden(cut.Find(".selectSourceContainer")));
        Assert.False(Hidden(cut.Find(".selectVideoContainer")));
        Assert.True(cut.Find("select.selectVideo").HasAttribute("disabled"));
        Assert.Equal(["1080p H264"], Texts(cut, "select.selectVideo option"));
        Assert.Equal(["English - AAC - Stereo", "German - AC3 - 5.1"], Texts(cut, "select.selectAudio option"));
        Assert.False(cut.Find("select.selectAudio").HasAttribute("disabled"));
        Assert.Equal(["Off", "English - SRT"], Texts(cut, "select.selectSubtitles option"));
        Assert.Equal(["Version", "Video", "Audio", "Subtitles"], Texts(cut, "form.trackSelections label.selectLabel"));
    }

    [Fact]
    public void Playback_starts_with_the_default_tracks()
    {
        var cut = RenderMovie();

        cut.Find(".btnPlay").Click();

        cut.WaitForAssertion(() => Assert.Single(Playback.PlayRequests));
        var request = Playback.PlayRequests[0];
        Assert.Equal(MovieId, request.MediaSourceId);
        Assert.Equal(1, request.AudioStreamIndex);
        Assert.Equal(-1, request.SubtitleStreamIndex);
        Assert.Equal(0, request.StartPositionTicks);
    }

    [Fact]
    public void Playback_starts_with_the_chosen_tracks()
    {
        var cut = RenderMovie();

        cut.Find("select.selectAudio").Change("2");
        cut.Find("select.selectSubtitles").Change("3");
        cut.Find(".btnPlay").Click();

        cut.WaitForAssertion(() => Assert.Single(Playback.PlayRequests));
        var request = Playback.PlayRequests[0];
        Assert.Equal(MovieId, request.MediaSourceId);
        Assert.Equal(2, request.AudioStreamIndex);
        Assert.Equal(3, request.SubtitleStreamIndex);
    }

    [Fact]
    public void Choosing_another_version_shows_that_version()
    {
        var otherId = TestItems.Id(2);
        object[] sources = [MovieSource(MovieId, "1080p"), new
        {
            Id = otherId,
            Name = "4K",
            Type = "Default",
            MediaStreams = new object[]
            {
                new { Type = "Video", Index = 0, DisplayTitle = "4K HEVC" },
                new { Type = "Audio", Index = 1, DisplayTitle = "French - AAC" }
            }
        }];
        var other = Movie();
        other["Id"] = otherId;
        other["Name"] = "Second Feature";
        other["MediaSources"] = sources;
        other["UserData"] = UserData(otherId, position: 10 * Minute);
        App.Server.OnGet("/Items/" + otherId, other);
        var cut = RenderMovie(change: movie => movie["MediaSources"] = sources);
        Assert.False(Hidden(cut.Find(".selectSourceContainer")));
        Assert.Equal(["1080p", "4K"], Texts(cut, "select.selectSource option"));

        cut.Find("select.selectSource").Change(otherId);

        // The other version is loaded: its tracks and its own resume position.
        cut.WaitForAssertion(() => Assert.Equal(["French - AAC"], Texts(cut, "select.selectAudio option")));
        cut.WaitForAssertion(() => Assert.Equal("Resume", cut.Find(".btnPlay").GetAttribute("title")));
        Assert.Equal(otherId, cut.Find("select.selectSource").GetAttribute("value"));
        Assert.True(Hidden(cut.Find(".selectSubtitlesContainer")));

        cut.Find(".btnPlay").Click();
        cut.WaitForAssertion(() => Assert.Single(Playback.PlayRequests));
        Assert.Equal(otherId, Playback.PlayRequests[0].MediaSourceId);
        Assert.Equal(1, Playback.PlayRequests[0].AudioStreamIndex);
        Assert.Null(Playback.PlayRequests[0].SubtitleStreamIndex);
        Assert.Equal(10 * Minute, Playback.PlayRequests[0].StartPositionTicks);
    }

