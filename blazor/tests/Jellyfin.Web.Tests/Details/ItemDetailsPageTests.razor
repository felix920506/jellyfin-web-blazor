    [Fact]
    public void An_artist_shows_albums_and_what_the_artist_appears_on()
    {
        App.Server.OnGet("/Items/" + ArtistId, Artist());
        App.Server.OnGet("/Items", request =>
        {
            if (request.Query("AlbumArtistIds") == ArtistId && request.Query("IncludeItemTypes") == "MusicAlbum")
            {
                return new { Items = new[] { Album(20, "The Album"), Album(25, "Another Album") }, TotalRecordCount = 120 };
            }

            return request.Query("ContributingArtistIds") == ArtistId ? Items(Album(26, "A Compilation")) : Items();
        });

        var cut = RenderDetails(ArtistId);

        cut.WaitForAssertion(() => Assert.Equal(2, cut.FindAll("#childrenContent .verticalSection[data-type=MusicAlbum] .card").Count));
        var albums = cut.Find("#childrenContent .verticalSection[data-type=MusicAlbum]");
        Assert.False(Hidden(albums));
        Assert.Equal("Albums", albums.QuerySelector("h2")!.TextContent.Trim());

        // More albums than the section asks for: a link to all of them.
        var more = albums.QuerySelector("a[is=emby-linkbutton]")!;
        Assert.False(Hidden(more));
        Assert.Equal($"#/list?type=MusicAlbum&artistId={ArtistId}&serverId={TestApp.ServerId}", more.GetAttribute("href"));
        var request = App.Server.RequestsTo("/Items").First(candidate => candidate.Query("AlbumArtistIds") == ArtistId);
        Assert.Equal("100", request.Query("Limit"));
        Assert.Equal("PremiereDate,ProductionYear,Sortname", request.Query("SortBy"));
        Assert.Equal("true", request.Query("Recursive"), ignoreCase: true);

        // Sections without items stay hidden; those the artist has nothing of are not asked for.
        Assert.True(Hidden(cut.Find("#childrenContent .verticalSection[data-type=Book]")));
        Assert.Empty(cut.FindAll("#childrenContent .verticalSection[data-type=MusicVideo]"));

        cut.WaitForAssertion(() => Assert.Single(cut.FindAll(".moreFromArtistSection .card")));
        Assert.Equal("Appears On", cut.Find(".moreFromArtistSection h2").TextContent.Trim());
        Assert.Equal(["btnPlay", "btnInstantMix", "btnShuffle", "btnUserRating", "btnMoreCommands"], VisibleButtons(cut));
    }

