    [Fact]
    public void A_movie_shows_people_scenes_and_similar_items()
    {
        App.Server.OnGet("/Items/" + MovieId + "/Similar", Items(TestItems.Movie(5, "Alike"), TestItems.Movie(6, "Also alike")));
        App.Server.OnGet("/Items/" + MovieId + "/Collections", Items(new
        {
            Id = CollectionId,
            Name = "The Collection",
            ServerId = TestApp.ServerId,
            Type = "BoxSet",
            IsFolder = true
        }));

        var cut = RenderMovie();

        Assert.Equal("Cast & Crew", cut.Find("#castCollapsible #peopleHeader").TextContent.Trim());
        Assert.Equal(["Ann Actor", "Dee Director"], Texts(cut, "#castContent .card .cardText-first"));
        Assert.Contains("personCard", cut.Find("#castContent .card").ClassName);
        Assert.Equal("Guest Stars", cut.Find("#guestCastCollapsible h2").TextContent.Trim());
        Assert.Single(cut.FindAll("#guestCastContent .card"));

        Assert.Equal("Scenes", cut.Find("#scenesCollapsible h2").TextContent.Trim());
        Assert.Equal(2, cut.FindAll("#scenesContent .chapterCard").Count);

        cut.WaitForAssertion(() => Assert.Equal(2, cut.FindAll("#similarCollapsible .card").Count));
        Assert.False(Hidden(cut.Find("#similarCollapsible")));
        Assert.Equal("More Like This", cut.Find("#similarCollapsible h2").TextContent.Trim());
        var similar = Assert.Single(App.Server.RequestsTo("/Items/" + MovieId + "/Similar"));
        Assert.Equal("12", similar.Query("limit"));
        Assert.Equal(UserIdText, similar.Query("userId"));

        cut.WaitForAssertion(() => Assert.Single(cut.FindAll("#collectionsCollapsible .card")));
        Assert.Equal("Collections", cut.Find("#collectionsCollapsible h2").TextContent.Trim());

        // What a movie cannot have is not in the page.
        Assert.Empty(cut.FindAll(".nextUpSection, #childrenCollapsible, #listChildrenCollapsible, #lyricsSection, .moreFromSeasonSection"));
        Assert.Empty(cut.FindAll(".moreFromArtistSection, #specialsCollapsible, #additionalPartsCollapsible, #musicVideosCollapsible"));
    }

