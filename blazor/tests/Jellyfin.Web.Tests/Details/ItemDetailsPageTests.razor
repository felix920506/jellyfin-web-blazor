    private static readonly string SeriesId = TestItems.Id(10);
    private static readonly string SeasonId = TestItems.Id(11);
    private static readonly string EpisodeId = TestItems.Id(12);
    private static readonly string AlbumId = TestItems.Id(20);
    private static readonly string SongId = TestItems.Id(21);
    private static readonly string ArtistId = TestItems.Id(30);
    private static readonly string PersonId = TestItems.Id(40);
    private static readonly string CollectionId = TestItems.Id(50);
    private static readonly string PlaylistId = TestItems.Id(60);

    private AppLocation _location = AppLocation.Parse("/details");
    private string? _id;
    private string? _context;
    private string? _musicArtist;
    private string? _genre;
    private string? _musicGenre;
    private string? _seriesTimerId;

    public override async Task InitializeAsync()
    {
        await base.InitializeAsync();

        // Sections without a rule of their own in a test are empty.
        var empty = new { Items = Array.Empty<object>(), TotalRecordCount = 0 };
        App.Server.OnGet("/Items", empty);
        App.Server.OnGet("/Persons", empty);
        App.Server.OnGet("/Similar", empty);
        App.Server.OnGet("/Collections", empty);
        App.Server.OnGet("/Shows/NextUp", empty);
        App.Server.OnGet("/LiveTv/Programs", empty);
        SignIn();
    }

    // --- Fixtures ---------------------------------------------------------------------------------

