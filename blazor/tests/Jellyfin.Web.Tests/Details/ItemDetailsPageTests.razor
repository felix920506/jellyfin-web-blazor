    {
        var cut = RenderMovie();

        Assert.Equal(["btnPlay", "btnPlayTrailer", "btnPlaystate", "btnUserRating", "btnMoreCommands"], VisibleButtons(cut));
        Assert.Equal(
            [
                "btnPlay", "btnReplay", "btnDownload", "btnPlayTrailer", "btnInstantMix", "btnShuffle", "btnCancelSeriesTimer",
                "btnCancelTimer", "btnPlaystate", "btnUserRating", "btnSplitVersions", "btnMoreCommands"
            ],
            cut.FindAll(".mainDetailButtons > button").Select(button => button.ClassList.First(name => name.StartsWith("btn", StringComparison.Ordinal))));
        Assert.Equal("Play", cut.Find(".btnPlay").GetAttribute("title"));
        Assert.Equal("resume", cut.Find(".btnPlay").GetAttribute("data-action"));
        Assert.False(Hidden(cut.Find(".mainDetailButtons")));
