        Assert.Equal("Primary,Backdrop,Banner,Thumb", request.Query("EnableImageTypes"));
        Assert.Equal(["btnPlay", "btnShuffle", "btnUserRating", "btnMoreCommands"], VisibleButtons(cut));
        cut.WaitForAssertion(() => Assert.Single(App.Server.RequestsTo("/Items/" + PlaylistId + "/Similar")));
    }

    [Fact]
    public void Those_who_may_edit_a_playlist_can_move_its_entries()
    {
        SetUpPlaylist(editable: true);
        App.Server.OnPost("/Playlists/" + PlaylistId + "/Items/entry2/Move/0");
        App.Server.OnPost("/Playlists/" + PlaylistId + "/Items/entry2/Move/2");

        var cut = RenderDetails(PlaylistId);

        cut.WaitForAssertion(() => Assert.Equal(3, cut.FindAll("#childrenContent button[data-customaction=jf-playlist-up]").Count));
        Assert.Equal("Up", cut.Find("#childrenContent button[data-customaction=jf-playlist-up]").GetAttribute("title"));
        Assert.Equal("Down", cut.Find("#childrenContent button[data-customaction=jf-playlist-down]").GetAttribute("title"));

        cut.FindAll("#childrenContent button[data-customaction=jf-playlist-up]")[1].Click();

        cut.WaitForAssertion(() => Assert.Single(App.Server.RequestsTo("/Playlists/" + PlaylistId + "/Items/entry2/Move/0")));

        // The list is loaded again after the move.
        cut.WaitForAssertion(() => Assert.Equal(2, App.Server.RequestsTo("/Playlists/" + PlaylistId + "/Items").Count));

        // The first entry cannot go further up.
        cut.FindAll("#childrenContent button[data-customaction=jf-playlist-up]")[0].Click();
        cut.FindAll("#childrenContent button[data-customaction=jf-playlist-down]")[1].Click();
        cut.WaitForAssertion(() => Assert.Single(App.Server.RequestsTo("/Playlists/" + PlaylistId + "/Items/entry2/Move/2")));
        Assert.DoesNotContain(App.Server.Requests, request => request.Uri.AbsolutePath.Contains("/entry1/Move/", StringComparison.Ordinal));
    }
