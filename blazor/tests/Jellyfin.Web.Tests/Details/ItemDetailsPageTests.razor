@using Jellyfin.Web.Components
@using Jellyfin.Web.Pages
@using Jellyfin.Web.Routing
@using Jellyfin.Web.Services
@using Jellyfin.Web.Tests.Items
@using Jellyfin.Web.Tests.Support
@inherits DetailsTestContext

