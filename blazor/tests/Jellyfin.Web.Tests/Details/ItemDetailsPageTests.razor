    // --- Movie: changes ---------------------------------------------------------------------------

    [Fact]
    public void A_resume_position_set_elsewhere_changes_the_play_buttons()
    {
        var cut = RenderMovie();
        var requests = App.Server.RequestsTo("/Items/" + MovieId).Count;

        ServerMessage("UserDataChanged", new
        {
            UserId = UserIdText,
            UserDataList = new[] { UserData(MovieId, position: 5 * Minute, favorite: true) }
        });

        cut.WaitForAssertion(() => Assert.Equal("Resume", cut.Find(".btnPlay").GetAttribute("title")));
        Assert.False(Hidden(cut.Find(".btnReplay")));
        Assert.Equal("true", cut.Find(".btnUserRating").GetAttribute("data-isfavorite"));

        // The item is not loaded again for it.
        Assert.Equal(requests, App.Server.RequestsTo("/Items/" + MovieId).Count);
    }

    [Fact]
    public void An_item_changed_in_the_library_is_loaded_again()
    {
        var cut = RenderMovie();
        var changed = Movie();
