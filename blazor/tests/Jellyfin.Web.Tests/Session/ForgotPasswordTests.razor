@* Forgot password and its PIN page. *@
@using System.Net
@using Jellyfin.Web
@using Jellyfin.Web.Pages.Session
@using Jellyfin.Web.Services
@using Jellyfin.Web.Tests.Support
@using Microsoft.Extensions.DependencyInjection
@inherits AppTestContext

@code {
    private (IRenderedComponent<ForgotPassword> Page, IRenderedComponent<Jellyfin.Web.Components.DialogHost> Dialogs) Submit(string name = "someone")
    {
        this.UseServer();
        var cut = Render<ForgotPassword>();
        var dialogs = this.RenderDialogs();
        cut.Find("#txtName").Input(name);
        cut.Find("form.forgotPasswordForm").Submit();
        return (cut, dialogs);
    }

    [Fact]
    public void The_form_is_rendered_like_the_original()
    {
        this.UseServer();

        var cut = Render<ForgotPassword>();

        Assert.NotNull(cut.Find("#forgotPasswordPage form.forgotPasswordForm #txtName"));
        Assert.Equal("Forgot Password", cut.Find("h1").TextContent);
        Assert.Equal("submit", cut.Find("#btnSubmit").GetAttribute("type"));
        Assert.NotNull(cut.Find("#btnCancel"));
    }

    [Fact]
    public void A_pin_file_is_announced_and_the_pin_page_opens_after_the_dialog()
    {
        App.Server.OnPost("/Users/ForgotPassword", new { Action = "PinCode", PinFile = "/config/<b>pin</b>.txt", PinExpirationDate = "2030-01-01T00:00:00Z" });

        var (cut, dialogs) = Submit("someone");

        dialogs.Eventually(() => Assert.Equal("Forgot Password", dialogs.Find(".formDialogHeaderTitle").TextContent));
        var text = dialogs.Find(".text");
        Assert.Contains("The following file has been created on your server", text.TextContent, StringComparison.Ordinal);
        Assert.Contains("Enter PIN here to finish Password reset", text.TextContent, StringComparison.Ordinal);
        // The path is text, not markup.
        Assert.Contains("/config/<b>pin</b>.txt", text.TextContent, StringComparison.Ordinal);
        Assert.Empty(text.QuerySelectorAll("b"));
        Assert.Equal(5, text.QuerySelectorAll("br").Length);
        Assert.Contains("\"EnteredUsername\":\"someone\"", Assert.Single(App.Server.RequestsTo("/Users/ForgotPassword")).Body, StringComparison.Ordinal);
        Assert.Equal(string.Empty, App.Browser.Hash);

        dialogs.Find(".formDialogFooter button").Click();

        cut.Eventually(() => Assert.Equal("/forgotpasswordpin", App.Browser.Hash));
    }

    [Fact]
    public void An_external_provider_is_opened_and_the_login_page_follows()
    {
        App.Server.OnPost("/Users/ForgotPassword", new { Action = "PinCode", PinFile = "https://sso.example/reset" });

        var (cut, dialogs) = Submit();

        dialogs.Eventually(() => Assert.Equal("You have been redirected to an external provider for the password reset.", dialogs.Find(".text").TextContent));
        Assert.Equal("https://sso.example/reset", Assert.Single(App.Browser.OpenedUrls).Url);

        dialogs.Find(".formDialogFooter button").Click();

        cut.Eventually(() => Assert.Equal("/login", App.Browser.Hash));
    }

    [Theory]
    [InlineData("ContactAdmin", "Please contact your system administrator to reset your password.")]
    [InlineData("InNetworkRequired", "Please try again within your home network to initiate the password reset process.")]
    public void Other_answers_only_show_their_message(string action, string message)
    {
        App.Server.OnPost("/Users/ForgotPassword", new { Action = action });

        var (cut, dialogs) = Submit();

        dialogs.Eventually(() => Assert.Equal(message, dialogs.Find(".text").TextContent));
        dialogs.Find(".formDialogFooter button").Click();

        dialogs.Eventually(() => Assert.Empty(this.Dialogs().Dialogs));
        Assert.Equal(string.Empty, App.Browser.Hash);
        Assert.Empty(App.Browser.OpenedUrls);
    }

    [Fact]
    public async Task A_failed_request_shows_nothing()
    {
        this.UseServer();
        App.Server.OnPost("/Users/ForgotPassword", _ => FakeHttp.Status(HttpStatusCode.InternalServerError));
        var cut = Render<ForgotPassword>();

        cut.Find("#txtName").Input("someone");
        await this.Settle(() => cut.Find("form.forgotPasswordForm").SubmitAsync());

        Assert.Empty(this.Dialogs().Dialogs);
        Assert.Empty(this.Toasts());
        Assert.Equal(string.Empty, App.Browser.Hash);
    }

    [Fact]
    public void A_redeemed_pin_lists_the_users_and_returns_to_the_start()
    {
        this.UseServer();
        App.Server.OnPost("/Users/ForgotPassword/Pin", new { Success = true, UsersReset = new[] { "anna", "<i>bob</i>" } });
        var cut = Render<ForgotPasswordPin>();
        var dialogs = this.RenderDialogs();

        cut.Find("#txtPin").Input("12-34-56-78");
        cut.Find("form.forgotPasswordPinForm").Submit();

        dialogs.Eventually(() => Assert.Equal("Password Reset", dialogs.Find(".formDialogHeaderTitle").TextContent));
        var text = dialogs.Find(".text");
        Assert.Contains("The following users have had their passwords reset.", text.TextContent, StringComparison.Ordinal);
        Assert.Contains("anna", text.TextContent, StringComparison.Ordinal);
        Assert.Contains("<i>bob</i>", text.TextContent, StringComparison.Ordinal);
        Assert.Contains("\"Pin\":\"12-34-56-78\"", Assert.Single(App.Server.RequestsTo("/Users/ForgotPassword/Pin")).Body, StringComparison.Ordinal);

        dialogs.Find(".formDialogFooter button").Click();

        cut.Eventually(() => Assert.Equal("/", App.Browser.Hash));
    }

    [Fact]
    public void An_invalid_pin_is_reported()
    {
        this.UseServer();
        App.Server.OnPost("/Users/ForgotPassword/Pin", new { Success = false, UsersReset = Array.Empty<string>() });
        var cut = Render<ForgotPasswordPin>();
        var dialogs = this.RenderDialogs();

        cut.Find("#txtPin").Input("nope");
        cut.Find("form.forgotPasswordPinForm").Submit();

        dialogs.Eventually(() => Assert.Equal("Password Reset", dialogs.Find(".formDialogHeaderTitle").TextContent));
        Assert.Contains("invalid or expired PIN", dialogs.Find(".text").TextContent, StringComparison.Ordinal);
        Assert.Equal(string.Empty, App.Browser.Hash);
    }

    [Fact]
    public async Task A_refused_pin_request_shows_nothing()
    {
        this.UseServer();
        App.Server.OnPost("/Users/ForgotPassword/Pin", _ => FakeHttp.Status(HttpStatusCode.NotFound));
        var cut = Render<ForgotPasswordPin>();

        cut.Find("#txtPin").Input("nope");
        await this.Settle(() => cut.Find("form.forgotPasswordPinForm").SubmitAsync());

        Assert.Empty(this.Dialogs().Dialogs);
        Assert.Equal(string.Empty, App.Browser.Hash);
    }
}
