@* The scheduled tasks (/dashboard/tasks) and a task's triggers (/dashboard/tasks/{id}). *@
@using System.Net
@using System.Text.Json
@using Jellyfin.Sdk.Generated.Models
@using Jellyfin.Web
@using Jellyfin.Web.Components
@using Jellyfin.Web.Pages.Dashboard
@using Jellyfin.Web.Services
@using Jellyfin.Web.Tests.Session
@using Jellyfin.Web.Tests.Support
@using Microsoft.AspNetCore.Components
@using Microsoft.AspNetCore.Components.Web
@inherits DashboardTestContext

@code {
    private const long TicksPerHour = 36_000_000_000;

    private static object Idle(string id, string name, string category, string? status = "Completed", bool hidden = false) => new
    {
        Id = id,
        Name = name,
        Category = category,
        State = "Idle",
        IsHidden = hidden,
        LastExecutionResult = status is null
            ? null
            : new { StartTimeUtc = Now.AddHours(-2), EndTimeUtc = Now.AddHours(-2).AddMinutes(5), Status = status },
    };

    private static object Running(string id, string name, string category, double? progress) =>
        new { Id = id, Name = name, Category = category, State = "Running", IsHidden = false, CurrentProgressPercentage = progress };

    private static object[] Tasks() =>
    [
        Idle("scan", "Scan media library", "Library"),
        Idle("logs", "Clean log directory", "Maintenance", status: "Failed"),
        Idle("chapters", "Extract chapter images", "Library", status: null),
    ];

    private IRenderedComponent<DashboardTasks> RenderTasks(params object[] tasks)
    {
        App.Server.OnGet("/ScheduledTasks", tasks);
        var cut = Render<DashboardTasks>();
        cut.Eventually(() => Assert.NotNull(cut.Find(".jf-dashboard-tasks")));
        return cut;
    }

    private static string[] Names(IRenderedComponent<DashboardTasks> cut) =>
        cut.FindAll(".jf-dashboard-task-name").Select(name => name.TextContent).ToArray();

    private void ScriptTask(params object[] triggers) => App.Server.OnGet("/ScheduledTasks/scan", new
    {
        Id = "scan",
        Name = "Scan media library",
        Description = "Looks for new files.",
        State = "Idle",
        Triggers = triggers,
    });

    private IRenderedComponent<DashboardTaskEdit> RenderTask()
    {
        var cut = Render<DashboardTaskEdit>(task => task.Add(t => t.Id, "scan"));
        cut.Eventually(() => Assert.NotNull(cut.Find(".jf-dashboard-task-title")));
        return cut;
    }

    private static string[] TriggerNames(IRenderedComponent<DashboardTaskEdit> cut) =>
        cut.FindAll(".jf-dashboard-trigger-name").Select(name => name.TextContent).ToArray();

    private JsonElement PostedTriggers(int index = 0) => BodiesTo("/ScheduledTasks/scan/Triggers")[index];

    [Fact]
    public void The_tasks_are_listed_by_category()
    {
        SignIn(admin: true);

        var cut = RenderTasks(Tasks());

        Assert.Equal(["Library", "Maintenance"], cut.FindAll(".jf-dashboard-task-category > h2").Select(title => title.TextContent));
        Assert.Equal(["Extract chapter images", "Scan media library", "Clean log directory"], Names(cut));
        Assert.Equal("#/dashboard/tasks/scan", cut.Find("[data-taskid=scan] a.jf-dashboard-task-link").GetAttribute("href"));
        Assert.Equal("false", Assert.Single(App.Server.RequestsTo("/ScheduledTasks")).Query("isHidden"));
    }

    [Fact]
    public void An_idle_task_tells_when_it_ran_last()
    {
        SignIn(admin: true);

        var cut = RenderTasks(Tasks());

        Assert.Equal(
            Get<Globalize>().Translate("LabelScheduledTaskLastRan", "2 hours ago", "5 minutes"),
            cut.Find("[data-taskid=scan] .jf-dashboard-task-last-ran").TextContent.Trim());
        Assert.Contains($"({this.T("LabelFailed")})", cut.Find("[data-taskid=logs] .jf-dashboard-task-last-ran").TextContent, StringComparison.Ordinal);
        Assert.Empty(cut.FindAll("[data-taskid=chapters] .jf-dashboard-task-state"));
        Assert.Equal(this.T("ButtonStart"), cut.Find("[data-taskid=scan] .jf-dashboard-task-action").GetAttribute("aria-label"));
    }

    [Theory]
    [InlineData("Cancelled", "LabelCancelled")]
    [InlineData("Aborted", "LabelAbortedByServerShutdown")]
    public void A_run_that_did_not_complete_says_why(string status, string key)
    {
        SignIn(admin: true);

        var cut = RenderTasks(Idle("scan", "Scan media library", "Library", status));

        Assert.Contains($"({this.T(key)})", cut.Find(".jf-dashboard-task-last-ran").TextContent, StringComparison.Ordinal);
    }

    [Fact]
    public void A_running_task_shows_its_progress()
    {
        SignIn(admin: true);

        var cut = RenderTasks(
            Running("scan", "Scan media library", "Library", 41.6),
            Running("logs", "Clean log directory", "Maintenance", null),
            new { Id = "chapters", Name = "Extract chapter images", Category = "Library", State = "Cancelling" });

        Assert.Equal("42%", cut.Find("[data-taskid=scan] .jf-dashboard-task-progress-text").TextContent);
        Assert.Equal(this.T("ButtonStop"), cut.Find("[data-taskid=scan] .jf-dashboard-task-action").GetAttribute("aria-label"));
        Assert.NotNull(cut.Find("[data-taskid=logs] .jf-dashboard-task-progress-bar"));
        Assert.Empty(cut.FindAll("[data-taskid=logs] .jf-dashboard-task-progress-text"));
        Assert.Equal(this.T("LabelStopping"), cut.Find("[data-taskid=chapters] .jf-dashboard-task-state").TextContent);
    }

    [Fact]
    public async Task A_task_is_started_and_stopped()
    {
        SignIn(admin: true);
        App.Server.OnPost("/ScheduledTasks/Running/logs");
        App.Server.OnDelete("/ScheduledTasks/Running/scan");
        var cut = RenderTasks(Running("scan", "Scan media library", "Library", 10), Idle("logs", "Clean log directory", "Maintenance"));

        await cut.Find("[data-taskid=logs] .jf-dashboard-task-action").ClickAsync(new MouseEventArgs());
        await cut.Find("[data-taskid=scan] .jf-dashboard-task-action").ClickAsync(new MouseEventArgs());

        cut.Eventually(() => Assert.Single(App.Server.RequestsTo("/ScheduledTasks/Running/scan")));
        Assert.Equal(HttpMethod.Post, Assert.Single(App.Server.RequestsTo("/ScheduledTasks/Running/logs")).Method);
        Assert.Equal(HttpMethod.Delete, App.Server.RequestsTo("/ScheduledTasks/Running/scan")[0].Method);
    }

    [Fact]
    public async Task A_refused_start_changes_nothing()
    {
        SignIn(admin: true);
        var cut = RenderTasks(Idle("logs", "Clean log directory", "Maintenance"));

        await cut.Find("[data-taskid=logs] .jf-dashboard-task-action").ClickAsync(new MouseEventArgs());

        cut.Eventually(() => Assert.Single(App.Server.RequestsTo("/ScheduledTasks/Running/logs")));
        Assert.Equal(["Clean log directory"], Names(cut));
    }

    [Fact]
    public void The_list_follows_the_servers_updates()
    {
        SignIn(admin: true);
        var cut = RenderTasks(Tasks());

        Push("ScheduledTasksInfo", new[]
        {
            Running("scan", "Scan media library", "Library", 7.4),
            Idle("logs", "Clean log directory", "Maintenance"),
            Idle("secret", "Hidden task", "Library", hidden: true),
        });

        cut.Eventually(() => Assert.Equal("7%", cut.Find("[data-taskid=scan] .jf-dashboard-task-progress-text").TextContent));
        Assert.Equal(["Scan media library", "Clean log directory"], Names(cut));

        Push("ScheduledTasksInfo", new[] { Idle("scan", "Scan media library", "Library") });

        cut.Eventually(() => Assert.NotNull(cut.Find("[data-taskid=scan] .jf-dashboard-task-last-ran")));
        Assert.Equal(["Scan media library"], Names(cut));
    }

    [Fact]
    public void The_spinner_stays_when_the_tasks_cannot_be_loaded()
    {
        SignIn(admin: true);

        var cut = Render<DashboardTasks>();

        cut.Eventually(() => Assert.Single(App.Server.RequestsTo("/ScheduledTasks")));
        Assert.Empty(cut.FindAll(".jf-dashboard-tasks"));
        Assert.Empty(cut.FindAll(".mud-alert"));
    }

    [Fact]
    public void A_task_lists_its_triggers()
    {
        SignIn(admin: true);
        ScriptTask(
            new { Type = "DailyTrigger", TimeOfDayTicks = 2 * TicksPerHour, MaxRuntimeTicks = TicksPerHour },
            new { Type = "WeeklyTrigger", DayOfWeek = "Friday", TimeOfDayTicks = 20 * TicksPerHour, MaxRuntimeTicks = 3 * TicksPerHour },
            new { Type = "IntervalTrigger", IntervalTicks = TicksPerHour / 2 },
            new { Type = "IntervalTrigger", IntervalTicks = TicksPerHour },
            new { Type = "IntervalTrigger", IntervalTicks = 12 * TicksPerHour },
            new { Type = "StartupTrigger" });
        var text = Get<TaskTriggerText>();
        var globalize = Get<Globalize>();

        var cut = RenderTask();

        Assert.Equal("Scan media library", cut.Find(".jf-dashboard-task-title").TextContent);
        Assert.Equal("Looks for new files.", cut.Find(".jf-dashboard-task-description").TextContent);
        Assert.Equal(
            [
                globalize.Translate("DailyAt", text.TimeOfDay(2 * TicksPerHour)),
                globalize.Translate("WeeklyAt", text.DayOfWeek(TaskTriggerInfo_DayOfWeek.Friday), text.TimeOfDay(20 * TicksPerHour)),
                globalize.Translate("EveryXMinutes", "30"),
                this.T("EveryHour"),
                globalize.Translate("EveryXHours", "12"),
                this.T("OnApplicationStartup"),
            ],
            TriggerNames(cut));
        Assert.Equal(
            [this.T("ValueTimeLimitSingleHour"), globalize.Translate("ValueTimeLimitMultiHour", "3")],
            cut.FindAll(".jf-dashboard-trigger-limit").Select(limit => limit.TextContent));
        Assert.Equal(6, cut.FindAll(".jf-dashboard-trigger-remove").Count);
    }

    [Fact]
    public void The_task_is_found_by_the_id_in_the_address()
    {
        SignIn(admin: true);
        ScriptTask();

        var cut = RenderTask();

        Assert.Single(App.Server.RequestsTo("/ScheduledTasks/scan"));
        Assert.Empty(TriggerNames(cut));
    }

    [Fact]
    public void Nothing_is_shown_for_a_task_that_does_not_exist()
    {
        SignIn(admin: true);

        var cut = Render<DashboardTaskEdit>(task => task.Add(t => t.Id, "gone"));

        cut.Eventually(() => Assert.Single(App.Server.RequestsTo("/ScheduledTasks/gone")));
        cut.Eventually(() => Assert.False(this.IsLoading()));
        Assert.Empty(cut.FindAll(".jf-dashboard-task-title"));
        Assert.Empty(cut.FindAll(".jf-dashboard-trigger-add"));
    }

    [Fact]
    public async Task A_daily_trigger_is_added_to_the_existing_ones()
    {
        SignIn(admin: true);
        ScriptTask(new { Type = "StartupTrigger" });
        App.Server.OnPost("/ScheduledTasks/scan/Triggers");
        var dialogs = this.RenderDialogs();
        var cut = RenderTask();

        await this.Settle(() => cut.Find(".jf-dashboard-trigger-add").ClickAsync(new MouseEventArgs()));
        dialogs.Eventually(() => Assert.NotNull(dialogs.Find("form.jf-dashboard-trigger-dialog")));
        Assert.Equal(this.T("ButtonAddScheduledTaskTrigger"), dialogs.Find(".jf-dashboard-dialog-title").TextContent);
        // A daily trigger asks for a time only.
        Assert.NotNull(dialogs.Find(".jf-dashboard-trigger-time"));
        Assert.Empty(dialogs.FindAll(".jf-dashboard-trigger-day"));
        Assert.Empty(dialogs.FindAll(".jf-dashboard-trigger-interval"));
        await ChooseAsync(dialogs, "jf-dashboard-trigger-time", 3 * TicksPerHour);
        await dialogs.Find("#jf-dashboard-trigger-limit").ChangeAsync(new ChangeEventArgs { Value = "1.5" });
        ScriptTask(new { Type = "StartupTrigger" }, new { Type = "DailyTrigger", TimeOfDayTicks = 3 * TicksPerHour });
        await dialogs.Find("form.jf-dashboard-trigger-dialog").SubmitAsync();

        cut.Eventually(() => Assert.Equal(2, TriggerNames(cut).Length));
        var triggers = PostedTriggers().EnumerateArray().ToList();
        Assert.Equal(2, triggers.Count);
        Assert.Equal("StartupTrigger", triggers[0].Text("Type"));
        Assert.Equal("DailyTrigger", triggers[1].Text("Type"));
        Assert.Equal(3 * TicksPerHour, triggers[1].GetProperty("TimeOfDayTicks").GetInt64());
        Assert.Equal(TicksPerHour * 3 / 2, triggers[1].GetProperty("MaxRuntimeTicks").GetInt64());
        Assert.False(triggers[1].TryGetProperty("IntervalTicks", out var interval) && interval.ValueKind != JsonValueKind.Null);
        Assert.Equal(2, App.Server.RequestsTo("/ScheduledTasks/scan").Count);
        Assert.Empty(this.Dialogs().Dialogs);
    }

    [Fact]
    public async Task A_weekly_trigger_asks_for_a_day_too()
    {
        SignIn(admin: true);
        ScriptTask();
        App.Server.OnPost("/ScheduledTasks/scan/Triggers");
        var dialogs = this.RenderDialogs();
        var cut = RenderTask();
        await this.Settle(() => cut.Find(".jf-dashboard-trigger-add").ClickAsync(new MouseEventArgs()));
        dialogs.Eventually(() => Assert.NotNull(dialogs.Find("form.jf-dashboard-trigger-dialog")));

        await ChooseAsync(dialogs, "jf-dashboard-trigger-type", TaskTriggerInfo_Type.WeeklyTrigger);
        dialogs.Eventually(() => Assert.NotNull(dialogs.Find(".jf-dashboard-trigger-day")));
        await ChooseAsync(dialogs, "jf-dashboard-trigger-day", TaskTriggerInfo_DayOfWeek.Saturday);
        await ChooseAsync(dialogs, "jf-dashboard-trigger-time", 22 * TicksPerHour);
        await dialogs.Find("form.jf-dashboard-trigger-dialog").SubmitAsync();

        cut.Eventually(() => Assert.Single(BodiesTo("/ScheduledTasks/scan/Triggers")));
        var trigger = Assert.Single(PostedTriggers().EnumerateArray());
        Assert.Equal("WeeklyTrigger", trigger.Text("Type"));
        Assert.Equal("Saturday", trigger.Text("DayOfWeek"));
        Assert.Equal(22 * TicksPerHour, trigger.GetProperty("TimeOfDayTicks").GetInt64());
        Assert.False(trigger.TryGetProperty("MaxRuntimeTicks", out var limit) && limit.ValueKind != JsonValueKind.Null);
    }

    [Fact]
    public async Task An_interval_trigger_asks_for_the_interval_only()
    {
        SignIn(admin: true);
        ScriptTask();
        App.Server.OnPost("/ScheduledTasks/scan/Triggers");
        var dialogs = this.RenderDialogs();
        var cut = RenderTask();
        await this.Settle(() => cut.Find(".jf-dashboard-trigger-add").ClickAsync(new MouseEventArgs()));
        dialogs.Eventually(() => Assert.NotNull(dialogs.Find("form.jf-dashboard-trigger-dialog")));

        await ChooseAsync(dialogs, "jf-dashboard-trigger-type", TaskTriggerInfo_Type.IntervalTrigger);
        dialogs.Eventually(() => Assert.NotNull(dialogs.Find(".jf-dashboard-trigger-interval")));
        Assert.Empty(dialogs.FindAll(".jf-dashboard-trigger-time"));
        Assert.Empty(dialogs.FindAll(".jf-dashboard-trigger-day"));
        // The shortest interval is the suggestion.
        Assert.Equal(TaskTriggerText.IntervalDurations[0], Chosen<DialogHost, long>(dialogs, "jf-dashboard-trigger-interval"));
        await ChooseAsync(dialogs, "jf-dashboard-trigger-interval", 6 * TicksPerHour);
        await dialogs.Find("form.jf-dashboard-trigger-dialog").SubmitAsync();

        cut.Eventually(() => Assert.Single(BodiesTo("/ScheduledTasks/scan/Triggers")));
        var trigger = Assert.Single(PostedTriggers().EnumerateArray());
        Assert.Equal("IntervalTrigger", trigger.Text("Type"));
        Assert.Equal(6 * TicksPerHour, trigger.GetProperty("IntervalTicks").GetInt64());
        Assert.False(trigger.TryGetProperty("TimeOfDayTicks", out var time) && time.ValueKind != JsonValueKind.Null);
    }

    [Fact]
    public async Task Nothing_is_saved_when_the_trigger_dialog_is_cancelled()
    {
        SignIn(admin: true);
        ScriptTask(new { Type = "StartupTrigger" });
        var dialogs = this.RenderDialogs();
        var cut = RenderTask();
        await this.Settle(() => cut.Find(".jf-dashboard-trigger-add").ClickAsync(new MouseEventArgs()));
        dialogs.Eventually(() => Assert.NotNull(dialogs.Find("form.jf-dashboard-trigger-dialog")));

        await dialogs.Find("form.jf-dashboard-trigger-dialog [data-id=cancel]").ClickAsync(new MouseEventArgs());

        cut.Eventually(() => Assert.Empty(this.Dialogs().Dialogs));
        Assert.Empty(App.Server.RequestsTo("/ScheduledTasks/scan/Triggers"));
        Assert.Single(App.Server.RequestsTo("/ScheduledTasks/scan"));
    }

    [Fact]
    public async Task A_trigger_is_removed_after_a_confirmation()
    {
        SignIn(admin: true);
        ScriptTask(new { Type = "StartupTrigger" }, new { Type = "IntervalTrigger", IntervalTicks = TicksPerHour });
        App.Server.OnPost("/ScheduledTasks/scan/Triggers");
        var dialogs = this.RenderDialogs();
        var cut = RenderTask();

        await ClickForDialogAsync(dialogs, cut.FindAll(".jf-dashboard-trigger-remove")[0]);
        Assert.Equal(this.T("HeaderDeleteTaskTrigger"), dialogs.Find(".jf-dashboard-dialog-title").TextContent);
        Assert.Equal(this.T("MessageDeleteTaskTrigger"), dialogs.Find(".jf-dashboard-dialog-text").TextContent);
        Assert.Equal(this.T("ButtonRemove"), dialogs.Find("[data-id=ok]").TextContent.Trim());
        ScriptTask(new { Type = "IntervalTrigger", IntervalTicks = TicksPerHour });
        await ConfirmDialogAsync(dialogs);

        cut.Eventually(() => Assert.Equal([this.T("EveryHour")], TriggerNames(cut)));
        var trigger = Assert.Single(PostedTriggers().EnumerateArray());
        Assert.Equal("IntervalTrigger", trigger.Text("Type"));
    }

    [Fact]
    public async Task A_trigger_stays_when_the_question_is_cancelled()
    {
        SignIn(admin: true);
        ScriptTask(new { Type = "StartupTrigger" });
        var dialogs = this.RenderDialogs();
        var cut = RenderTask();

        await ClickForDialogAsync(dialogs, cut.Find(".jf-dashboard-trigger-remove"));
        await CancelDialogAsync(dialogs);

        cut.Eventually(() => Assert.Empty(this.Dialogs().Dialogs));
        Assert.Empty(App.Server.RequestsTo("/ScheduledTasks/scan/Triggers"));
        Assert.Single(TriggerNames(cut));
    }

    [Fact]
    public async Task The_task_is_read_again_when_saving_fails()
    {
        SignIn(admin: true);
        ScriptTask(new { Type = "StartupTrigger" });
        var dialogs = this.RenderDialogs();
        var cut = RenderTask();

        await ClickForDialogAsync(dialogs, cut.Find(".jf-dashboard-trigger-remove"));
        await ConfirmDialogAsync(dialogs);

        cut.Eventually(() => Assert.Equal(2, App.Server.RequestsTo("/ScheduledTasks/scan").Count));
        Assert.Single(TriggerNames(cut));
    }
}
