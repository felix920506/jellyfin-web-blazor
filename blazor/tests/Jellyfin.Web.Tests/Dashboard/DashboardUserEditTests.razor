    [Fact]
    public async Task An_access_schedule_is_added_from_its_dialog()
    {
        SignIn(admin: true);
        ScriptAlice(ParentalPolicy());
        ScriptRatings();
        App.Server.OnPost("/Policy");
        var dialogs = this.RenderDialogs();
        var cut = RenderParental();

        await this.Settle(() => cut.Find("#btnAddSchedule").ClickAsync(new MouseEventArgs()));
        dialogs.Eventually(() => Assert.NotNull(dialogs.Find("form.scheduleForm")));
        Assert.Equal(10, dialogs.FindAll("#selectDay option").Count);
        Assert.Equal(49, dialogs.FindAll("#selectStart option").Count);
        await dialogs.Find("#selectDay").ChangeAsync(new ChangeEventArgs { Value = "Weekend" });
        await dialogs.Find("#selectStart").ChangeAsync(new ChangeEventArgs { Value = "9.5" });
        await dialogs.Find("#selectEnd").ChangeAsync(new ChangeEventArgs { Value = "24" });
        await this.Settle(() => dialogs.Find("form.scheduleForm").SubmitAsync());

        cut.Eventually(() => Assert.Equal(2, cut.FindAll(".liSchedule").Count));
        var added = cut.FindAll(".liSchedule")[1];
        Assert.Equal("Weekend", added.GetAttribute("data-day"));
        Assert.Equal("9.5", added.GetAttribute("data-start"));
        Assert.Equal("24", added.GetAttribute("data-end"));

        await cut.Find("form.userParentalControlForm").SubmitAsync();
        cut.Eventually(() => Assert.Single(App.Server.RequestsTo("/Policy")));
        var schedules = PostedPolicy().GetProperty("AccessSchedules").EnumerateArray().ToList();
        Assert.Equal(2, schedules.Count);
        Assert.Equal("Weekend", schedules[1].Text("DayOfWeek"));
        Assert.Equal(9.5, schedules[1].GetProperty("StartHour").GetDouble());
        Assert.Equal(24, schedules[1].GetProperty("EndHour").GetDouble());
    }

