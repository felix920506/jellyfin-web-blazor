    [Fact]
    public void A_library_change_reported_by_the_server_reloads_the_list()
    {
        SignIn();
        var cut = RenderLoaded();

        _movies.Add((15, "Omega"));
        // A change in another library leaves the list alone (the refresh would come after ItemsContainer.RefreshDelay).
        var requests = App.Server.RequestsTo("/Items").Count;
        ServerMessage("LibraryChanged", new { ItemsAdded = new[] { TestItems.Id(15) }, CollectionFolders = new[] { TestItems.Id(99) } });
        Thread.Sleep(200);
        Assert.Equal(requests, App.Server.RequestsTo("/Items").Count);

        ServerMessage("LibraryChanged", new { ItemsAdded = new[] { TestItems.Id(15) }, CollectionFolders = new[] { LibraryId } });

        cut.WaitForAssertion(() => Assert.Equal(5, cut.FindAll(".itemsContainer .card").Count));
        cut.WaitForAssertion(() => Assert.Equal("5", Count(cut)));
    }

    [Theory]
    [InlineData("/tv", "Shows")]
    [InlineData("/music", "Albums")]
    [InlineData("/books", "Folders")]
    [InlineData("/boxsets", "Collections")]
    [InlineData("/playlists", "Playlists")]
    [InlineData("/homevideos", "Folders")]
    [InlineData("/musicvideos", "Folders")]
    [InlineData("/mixed", "Folders")]
    public void Every_library_route_renders_its_own_page_and_default_view(string route, string label)
    {
        SignIn();
        _location = AppLocation.Parse(route + "?topParentId=" + TestItems.Id(2));

        var cut = RenderPage();

        cut.WaitForAssertion(() => Assert.Equal(label, cut.Find(".jf-library-view-label").TextContent.Trim()));
        Assert.Equal(LibraryRoutes.Find(route)!.PageId, cut.Find("[data-role='page']").Id);
        cut.WaitForAssertion(() => Assert.NotEmpty(cut.FindAll(".noItemsMessage")));
    }

    private sealed class RecordingHandler : IItemCommandHandler
    {
        public HashSet<string> Commands { get; } = [];

        public List<(string Command, BaseItemDto Item, ItemActionContext Context)> Calls { get; } = [];

        public bool CanHandle(string command, BaseItemDto item) => Commands.Contains(command);

        public Task<ItemCommandResult> ExecuteAsync(string command, BaseItemDto item, ItemActionContext context)
        {
            Calls.Add((command, item, context));
            return Task.FromResult(ItemCommandResult.None);
        }
    }
}
