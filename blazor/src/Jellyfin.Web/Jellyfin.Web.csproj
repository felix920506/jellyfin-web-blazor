<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <PropertyGroup>
    <RootNamespace>Jellyfin.Web</RootNamespace>
    <OverrideHtmlAssetPlaceholders>true</OverrideHtmlAssetPlaceholders>
    <!-- The toolchain image has no wasm-tools workload: no AOT, no native relink. -->
    <RunAOTCompilation>false</RunAOTCompilation>
    <WasmBuildNative>false</WasmBuildNative>
    <!-- Dates and numbers are formatted by the browser (Intl) through IBrowser, so the runtime
         ships without ICU data. That also keeps the published output free of .dat files, which a
         Jellyfin server would not serve from its /web directory. Local time comes from
         IBrowser.UtcOffsetMinutes; do not rely on TimeZoneInfo.Local.
         (InvariantTimezone would need a native relink, i.e. the wasm-tools workload.) -->
    <InvariantGlobalization>true</InvariantGlobalization>
    <JsonSerializerIsReflectionEnabledByDefault>true</JsonSerializerIsReflectionEnabledByDefault>
    <!-- RouteTable, Composition and ShellSlots discover Razor types by reflection. Rooting this
         application assembly keeps those contracts and Kiota's reflection-based JSON models
         available in the trimmed publish without disabling trimming for framework assemblies. -->
  </PropertyGroup>

  <ItemGroup>
    <TrimmerRootAssembly Include="$(AssemblyName)" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" PrivateAssets="all" />
    <PackageReference Include="Jellyfin.Sdk" />
    <PackageReference Include="MudBlazor" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Jellyfin.Web.Tests" />
  </ItemGroup>

</Project>
