@namespace Jellyfin.Web.Components
@*
    The upcoming episodes of a TV library (features/libraries/components/upcoming/UpcomingView.tsx):
    episodes grouped by the day they air, loaded 25 at a time as the end of the list comes into view.
*@
@implements IAsyncDisposable
@inject LibraryData Data
@inject ILibraryInterop Interop
@inject DateTimeText Dates
@inject IBrowser Browser
@inject Globalize Globalize
@inject LoadingService Loading

@if (_loaded && _items.Count == 0)
{
    <NoItemsMessage Message="MessagePleaseEnsureInternetMetadata" />
}
else
{
    <div class="padded-bottom-page jf-library-upcoming">
        @foreach (var group in _groups)
        {
            <div @key="group.Key" class="verticalSection">
                <SectionHeader Title="@group.Title" />
                <ItemsContainer Class="vertical-wrap padded-left padded-right" Items="group.Items" CardOptions="_cards" ParentId="@ParentId" Context="@Content.CollectionType" />
            </div>
        }
    </div>
}
<div @ref="_sentinel" class="jf-library-sentinel"></div>

@code {
    private static readonly object GroupDateOptions = new { weekday = "long", month = "short", day = "numeric" };

    private readonly List<BaseItemDto> _items = [];
    private List<Group> _groups = [];
    private CardOptions _cards = new();
    private ElementReference _sentinel;
    private IAsyncDisposable? _watch;
    private bool _loaded;
    private bool _loading;
    private bool _hasMore = true;
    private bool _disposed;

    [Parameter, EditorRequired]
    public LibraryTabContent Content { get; set; } = default!;

    /// <summary>The library (?topParentId=); nothing is loaded without one.</summary>
    [Parameter]
    public string? ParentId { get; set; }

    protected override async Task OnInitializedAsync()
    {
        _cards = LibraryViewOptions.UpcomingCards(Content);
        if (string.IsNullOrEmpty(ParentId))
        {
            _hasMore = false;
            _loaded = true;
            return;
        }

        Loading.Show();
        try
        {
            await LoadMoreAsync();
        }
        finally
        {
            Loading.Hide();
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            var watch = await Interop.WatchVisibilityAsync(_sentinel, "600px", () => _ = InvokeAsync(LoadMoreAsync));
            if (_disposed)
            {
                await watch.DisposeAsync();
            }
            else
            {
                _watch = watch;
            }
        }
    }

    public async ValueTask DisposeAsync()
    {
        _disposed = true;
        if (_watch is { } watch)
        {
            _watch = null;
            await watch.DisposeAsync();
        }
    }

    private async Task LoadMoreAsync()
    {
        if (_loading || !_hasMore || _disposed || string.IsNullOrEmpty(ParentId))
        {
            return;
        }

        _loading = true;
        try
        {
            var page = await Data.GetUpcomingAsync(ParentId, _items.Count);
            _hasMore = page.Count >= LibraryData.UpcomingPageSize;
            _items.AddRange(page);
            _groups = BuildGroups();
        }
        catch (HttpRequestException exception)
        {
            _hasMore = false;
            AppLog.Warn("Loading the upcoming episodes failed: " + exception.Message);
        }
        finally
        {
            _loading = false;
            _loaded = true;
        }

        StateHasChanged();
    }

    // groupsUpcomingEpisodes: consecutive episodes of the same local day share a section.
    private List<Group> BuildGroups()
    {
        var groups = new List<Group>();
        var today = Local(Dates.Now).Date;
        foreach (var item in _items)
        {
            var title = string.Empty;
            if (item.PremiereDate is { } premiere)
            {
                var day = Local(premiere).Date;
                title = day == today.AddDays(-1) ? Globalize["Yesterday"] : Globalize.FormatDate(premiere, GroupDateOptions);
            }

            if (groups.Count > 0 && groups[^1].Title == title)
            {
                groups[^1] = groups[^1] with { Items = [.. groups[^1].Items, item] };
            }
            else
            {
                groups.Add(new Group(groups.Count + ":" + title, title, [item]));
            }
        }

        return groups;
    }

    private DateTimeOffset Local(DateTimeOffset date) => date.ToOffset(TimeSpan.FromMinutes(Browser.UtcOffsetMinutes(date)));

    private sealed record Group(string Key, string Title, IReadOnlyList<BaseItemDto> Items);
}
