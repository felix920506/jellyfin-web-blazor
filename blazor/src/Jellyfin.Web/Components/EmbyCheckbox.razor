@* <input type="checkbox" is="emby-checkbox"> with its label. Wrap in .checkboxContainer where the original does. *@
<label class="emby-checkbox-label @LabelClass">
    <input type="checkbox" id="@Id" class="emby-checkbox @Class" data-embycheckbox="true" checked="@Value" disabled="@Disabled"
           @onchange="OnChangeAsync" @attributes="Attributes" />
    <span class="checkboxLabel">@(ChildContent ?? (RenderFragment)(b => b.AddContent(0, Label)))</span>
    <span class="checkboxOutline @OutlineClass">
        <span class="material-icons checkboxIcon checkboxIcon-checked check" aria-hidden="true"></span>
        <span class="material-icons checkboxIcon checkboxIcon-unchecked" aria-hidden="true"></span>
    </span>
</label>

@code {
    [Parameter]
    public string? Id { get; set; }

    [Parameter]
    public string? Label { get; set; }

    [Parameter]
    public bool Value { get; set; }

    [Parameter]
    public EventCallback<bool> ValueChanged { get; set; }

    [Parameter]
    public string? Class { get; set; }

    [Parameter]
    public string? LabelClass { get; set; }

    [Parameter]
    public string? OutlineClass { get; set; }

    [Parameter]
    public bool Disabled { get; set; }

    /// <summary>Label content, when plain text is not enough.</summary>
    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    [Parameter(CaptureUnmatchedValues = true)]
    public IReadOnlyDictionary<string, object>? Attributes { get; set; }

    private Task OnChangeAsync(ChangeEventArgs args)
    {
        Value = args.Value is true;
        return ValueChanged.InvokeAsync(Value);
    }
}
