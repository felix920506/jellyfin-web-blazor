@namespace Jellyfin.Web.Components
@* Browsing the images of the metadata providers. Port of components/imageDownloader/imageDownloader.js. *@
@using System.Text.Json.Nodes
@inject ItemDialogApi Api
@inject LoadingService Loading
@inject Globalize Globalize

<div class="formDialogHeader">
    <IconButton Icon="arrow_back" Class="btnCancel autoSize" Title="@Globalize["ButtonBack"]" tabindex="-1" OnClick="() => Dialog.Cancel()" />
    <h3 class="formDialogHeaderTitle">@Globalize["Search"]</h3>
</div>

<div class="formDialogContent smoothScrollY">
    <div class="dialogContentInner">
        <div class="flex align-items-center justify-content-center flex-wrap-wrap" style="margin: 2em 0;">
            <div style="margin: 0;">
                <EditorSelect Id="selectImageProvider" name="selectImageProvider" Label="@Globalize["LabelSource"]" Value="@(_provider ?? string.Empty)"
                              ValueChanged="OnProviderChangedAsync">
                    <option value="">@Globalize["All"]</option>
                    @foreach (var provider in _providers)
                    {
                        <option value="@provider">@provider</option>
                    }
                </EditorSelect>
            </div>
            <div style="margin-left:1em;">
                <EditorSelect Id="selectBrowsableImageType" name="selectBrowsableImageType" Label="@Globalize["LabelType"]" Value="@_imageType"
                              ValueChanged="OnTypeChangedAsync">
                    @foreach (var type in ImageEditorLogic.BrowsableTypes)
                    {
                        <option value="@type">@Globalize[type]</option>
                    }
                </EditorSelect>
            </div>
            <div class="availableImagesPaging" style="margin-left:1em;">
                @if (_loaded)
                {
                    var (start, end) = ImageEditorLogic.PageRange(_startIndex, PageSize, _total);
                    <div class="listPaging">
                        <span style="margin-right: 10px;">@Globalize.Translate("ListPaging", start, end, _total)</span>
                        @if (_total > PageSize)
                        {
                            <div data-role="controlgroup" data-type="horizontal" style="display:inline-block;">
                                <IconButton Icon="arrow_back" Class="btnPreviousPage autoSize" Title="@Globalize["Previous"]" Disabled="@(_busy || _startIndex == 0)"
                                            OnClick="() => PageAsync(-PageSize)" />
                                <IconButton Icon="arrow_forward" Class="btnNextPage autoSize" Title="@Globalize["Next"]" Disabled="@(_busy || _startIndex + PageSize >= _total)"
                                            OnClick="() => PageAsync(PageSize)" />
                            </div>
                        }
                    </div>
                }
            </div>
            @* EmbyCheckbox cannot style or name its label, which these two need. *@
            <label class="emby-checkbox-label" style="margin: 0 0 0 1em;width:auto;">
                <input id="chkAllLanguages" type="checkbox" class="emby-checkbox" data-embycheckbox="true" checked="@_allLanguages"
                       @onchange="args => OnAllLanguagesChangedAsync(args.Value is true)" />
                <span class="checkboxLabel">@Globalize["AllLanguages"]</span>
                <span class="checkboxOutline">
                    <span class="material-icons checkboxIcon checkboxIcon-checked check" aria-hidden="true"></span>
                    <span class="material-icons checkboxIcon checkboxIcon-unchecked" aria-hidden="true"></span>
                </span>
            </label>
            <label id="lblShowParentImages" class="@("emby-checkbox-label" + (string.IsNullOrEmpty(ParentId) ? " hide" : null))" style="margin: 0 0 0 1em;width:auto;">
                <input id="chkShowParentImages" type="checkbox" class="emby-checkbox" data-embycheckbox="true" checked="@_showParentImages"
                       @onchange="args => OnShowParentImagesChangedAsync(args.Value is true)" />
                <span class="checkboxLabel">@Globalize["ShowParentImages"]</span>
                <span class="checkboxOutline">
                    <span class="material-icons checkboxIcon checkboxIcon-checked check" aria-hidden="true"></span>
                    <span class="material-icons checkboxIcon checkboxIcon-unchecked" aria-hidden="true"></span>
                </span>
            </label>
        </div>

        <div class="availableImagesList vertical-wrap centered">
            @foreach (var image in _images)
            {
                var shape = ImageEditorLogic.RemoteImageShape(_shownType, ItemType);
                var url = image.Text("Url");
                var size = ImageEditorLogic.RemoteImageSize(image);
                var rating = ImageEditorLogic.RemoteImageRating(image);
                <div class="@($"card scalableCard imageEditorCard {shape}Card {shape}Card-scalable")" data-imageprovider="@image.Text("ProviderName")"
                     data-imageurl="@url" data-imagetype="@image.Text("Type")" @key="url">
                    <div class="cardBox visualCardBox">
                        <div class="cardScalable visualCardBox-cardScalable" style="background-color:transparent;">
                            <div class="@("cardPadder-" + shape)"></div>
                            <div class="cardContent">
                                <a target="_blank" href="@url" class="emby-button button-link cardImageContainer"
                                   style="@($"background-position:center center;background-size:contain;background-image:url('{url}');")"></a>
                            </div>
                        </div>
                        <div class="cardFooter visualCardBox-cardFooter">
                            <div class="cardText cardTextCentered">@image.Text("ProviderName")</div>
                            @if (size is not null)
                            {
                                <div class="cardText cardText-secondary cardTextCentered">@size</div>
                            }
                            @if (rating is not null)
                            {
                                <div class="cardText cardText-secondary cardTextCentered">@rating</div>
                            }
                            <div class="cardText cardTextCentered">
                                <IconButton Icon="cloud_download" Class="btnDownloadRemoteImage autoSize" Title="@Globalize["Download"]"
                                            OnClick="() => DownloadAsync(image)" />
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</div>

@code {
    // The original takes 6 at a time on slow (TV) browsers, which the port does not target.
    private const int PageSize = 30;

    private IReadOnlyList<JsonNode?> _images = [];
    private List<string> _providers = [];
    private string? _provider;
    private string? _imageType = "Primary";
    private string? _shownType = "Primary";
    private int _startIndex;
    private int _total;
    private bool _allLanguages;
    private bool _showParentImages;
    private bool _loaded;
    private bool _busy;

    [CascadingParameter]
    public DialogInstance Dialog { get; set; } = default!;

    /// <summary>The item the image is for.</summary>
    [Parameter, EditorRequired]
    public string ItemId { get; set; } = string.Empty;

    /// <summary>The item's type; it decides the shape of the cards.</summary>
    [Parameter]
    public string? ItemType { get; set; }

    /// <summary>The image type selected at first; "Primary" when null.</summary>
    [Parameter]
    public string? ImageType { get; set; }

    /// <summary>The parent whose images can be shown instead (the series of a season).</summary>
    [Parameter]
    public string? ParentId { get; set; }

    /// <summary>
    /// Opens the browser (<c>ImageDownloader.show(itemId, serverId, itemType, imageType, parentId)</c>).
    /// True when an image was downloaded to the item.
    /// </summary>
    public static async Task<bool> ShowAsync(AppDialogs dialogs, string itemId, string? itemType, string? imageType = null, string? parentId = null) =>
        await dialogs.ShowAsync<ImageDownloader>(
            new Dictionary<string, object?>
            {
                [nameof(ItemId)] = itemId,
                [nameof(ItemType)] = itemType,
                [nameof(ImageType)] = imageType,
                [nameof(ParentId)] = parentId
            },
            new AppDialogOptions { Class = null }) is true;

    protected override Task OnInitializedAsync()
    {
        _imageType = string.IsNullOrEmpty(ImageType) ? "Primary" : ImageType;
        return ReloadAsync();
    }

    // Port of reloadBrowsableImages() and renderRemoteImages().
    private async Task ReloadAsync()
    {
        Loading.Show();
        _busy = true;
        var type = _imageType;
        try
        {
            var itemId = _showParentImages && !string.IsNullOrEmpty(ParentId) ? ParentId : ItemId;
            var result = await Api.GetAsync(
                $"Items/{itemId}/RemoteImages",
                ("type", type),
                ("startIndex", _startIndex),
                ("limit", PageSize),
                ("IncludeAllLanguages", _allLanguages),
                ("ProviderName", _provider));
            _images = result.List("Images");
            _total = (int)(result.Number("TotalRecordCount") ?? 0);
            _providers = result.Strings("Providers");
            _shownType = type;
            _loaded = true;
        }
        catch (Exception exception) when (ItemDialogApi.IsFailure(exception))
        {
            AppLog.Warn("Loading the remote images failed: " + exception.Message);
        }
        finally
        {
            _busy = false;
            Loading.Hide();
        }
    }

    private Task FirstPageAsync()
    {
        _startIndex = 0;
        return ReloadAsync();
    }

    private Task OnTypeChangedAsync(string? type)
    {
        _imageType = type;
        _provider = null;
        return FirstPageAsync();
    }

    private Task OnProviderChangedAsync(string? provider)
    {
        _provider = provider;
        return FirstPageAsync();
    }

    private Task OnAllLanguagesChangedAsync(bool value)
    {
        _allLanguages = value;
        return FirstPageAsync();
    }

    private Task OnShowParentImagesChangedAsync(bool value)
    {
        _showParentImages = value;
        return FirstPageAsync();
    }

    private Task PageAsync(int by)
    {
        _startIndex = Math.Max(0, _startIndex + by);
        return ReloadAsync();
    }

    // Port of downloadRemoteImage(): the image always goes to the item itself, also when the parent's images are shown.
    private async Task DownloadAsync(JsonNode? image)
    {
        Loading.Show();
        try
        {
            await Api.PostAsync(Api.GetUrl(
                $"Items/{ItemId}/RemoteImages/Download",
                ("Type", image.Text("Type")),
                ("ImageUrl", image.Text("Url")),
                ("ProviderName", image.Text("ProviderName"))));
            Loading.Hide();
            Dialog.Close(true);
        }
        catch (Exception exception) when (ItemDialogApi.IsFailure(exception))
        {
            AppLog.Warn("Downloading the remote image failed: " + exception.Message);
            Loading.Hide();
        }
    }
}
