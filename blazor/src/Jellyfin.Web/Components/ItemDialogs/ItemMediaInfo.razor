@namespace Jellyfin.Web.Components
@* "Media info". Port of components/itemMediaInfo/itemMediaInfo.js. *@
@using System.Text.Json.Nodes
@inject JellyfinApi JellyfinApi
@inject IItemDialogsInterop Interop
@inject ToastService Toasts
@inject Globalize Globalize

<div class="formDialogHeader">
    <IconButton Icon="arrow_back" Class="btnCancel autoSize" Title="@Globalize["ButtonBack"]" tabindex="-1" OnClick="() => Dialog.Cancel()" />
    <h3 class="formDialogHeaderTitle">@Globalize["MoreMediaInfo"]</h3>
</div>
<div class="formDialogContent smoothScrollY">
    <div class="dialogContentInner" style="padding: 1em">
        <div id="mediaInfoContent" class="mediaInfoContent">
            @if (_sources.Count > 1)
            {
                <br />
            }
            @for (var i = 0; i < _sources.Count; i++)
            {
                var source = _sources[i];
                if (i > 0)
                {
                    <div style="border-top:1px solid #444;margin: 1em 0;"></div>
                }
                <div class="mediaInfoSource">
                    @if (source.Name is not null)
                    {
                        <div>
                            <h2 class="mediaInfoStreamType">@source.Name<IconButton Icon="content_copy" Class="btnCopy" Title="@Globalize["Copy"]" OnClick="() => CopyAsync(source.CopyText)" /></h2>
                        </div>
                    }
                    @foreach (var info in source.Attributes)
                    {
                        <span class="mediaInfoLabel">@info.Label</span><span class="hide">: </span><span class="mediaInfoAttribute" dir="@(info.Ltr ? "ltr" : null)">@info.Value</span>
                        <br />
                    }
                    @foreach (var stream in source.Streams)
                    {
                        <div class="mediaInfoStream">
                            <h2 class="mediaInfoStreamType">@stream.Title<IconButton Icon="content_copy" Class="btnCopy" Title="@Globalize["Copy"]" OnClick="() => CopyAsync(stream.CopyText)" /></h2>
                            @for (var a = 0; a < stream.Attributes.Count; a++)
                            {
                                var info = stream.Attributes[a];
                                if (a > 0)
                                {
                                    <br />
                                }
                                <span class="mediaInfoLabel">@info.Label</span><span class="hide">: </span><span class="mediaInfoAttribute">@info.Value</span>
                            }
                        </div>
                    }
                </div>
            }
        </div>
    </div>
</div>

@code {
    private IReadOnlyList<MediaInfoSource> _sources = [];

    [CascadingParameter]
    public DialogInstance Dialog { get; set; } = default!;

    /// <summary>The item with its media sources, as the server sent it.</summary>
    [Parameter]
    public JsonObject? Item { get; set; }

    /// <summary>Shows the media info of an item that was loaded with its media sources.</summary>
    public static Task ShowAsync(AppDialogs dialogs, JsonObject item) =>
        dialogs.ShowAsync<ItemMediaInfo>(new Dictionary<string, object?> { [nameof(Item)] = item });

    protected override void OnParametersSet() =>
        _sources = MediaInfoBuilder.Build(Item, JellyfinApi.IsAdmin, Globalize);

    private async Task CopyAsync(string text) =>
        Toasts.Show(Globalize.Translate(await Interop.CopyTextAsync(text) ? "Copied" : "CopyFailed"));
}
