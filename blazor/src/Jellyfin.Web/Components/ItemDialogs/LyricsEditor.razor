@namespace Jellyfin.Web.Components
@* "Edit lyrics". Port of components/lyricseditor/lyricseditor.js and its template. *@
@using System.Text.Json.Nodes
@inject ItemDialogApi Api
@inject AppDialogs Dialogs
@inject LoadingService Loading
@inject ToastService Toasts
@inject Globalize Globalize

<div class="formDialogHeader">
    <IconButton Icon="arrow_back" Class="btnCancel autoSize" Title="@Globalize["ButtonBack"]" tabindex="-1" OnClick="() => Dialog.Cancel()" />
    <h3 class="formDialogHeaderTitle">@Globalize["Lyrics"]</h3>
</div>

<div class="formDialogContent smoothScrollY">
    <div class="dialogContentInner dialog-content-centered">
        <div class="currentLyrics" style="margin-bottom:2em;">
            @if (_currentLyrics.Count > 0)
            {
                <h2>@Globalize["Lyrics"]</h2>
                <div>@Lines(_currentLyrics)</div>
            }
        </div>

        <h2>@Globalize["SearchForLyrics"]</h2>

        <p class="@("originalFile" + (string.IsNullOrEmpty(_item.Text("Path")) ? " hide" : null))" style="margin: 1.5em 0;">
            <span class="originalLyricsFileLabel secondaryText">@Globalize["File"]</span>
            <span class="pathValue">@SubtitleLyricsLogic.FileName(_item.Text("Path"))</span>
        </p>

        <form class="lyricsSearchForm" style="max-width: none;" @onsubmit="SearchAsync" @onsubmit:preventDefault="true">
            <div class="flex align-items-center">
                <button type="submit" class="paper-icon-button-light btnSearchLyrics flex-shrink-zero emby-select-iconbutton" title="@Globalize["Search"]">
                    <Icon Name="search" />
                </button>
                <button type="button" class="paper-icon-button-light btnOpenUploadMenu flex-shrink-zero emby-select-iconbutton" title="@Globalize["Upload"]"
                        @onclick="UploadAsync">
                    <Icon Name="add" />
                </button>
                <button type="button" class="paper-icon-button-light btnDeleteLyrics flex-shrink-zero emby-select-iconbutton" title="@Globalize["Delete"]"
                        @onclick="DeleteAsync">
                    <Icon Name="delete" />
                </button>
            </div>
            <button type="submit" class="emby-button raised btnSubmit block button-submit hide">@Globalize["Search"]</button>
        </form>
        <br />

        <div class="lyricsResults">
            @foreach (var (provider, results) in SubtitleLyricsLogic.GroupByProvider(_results, result => result.Text("ProviderName")))
            {
                <h2>@provider</h2>
                <div>
                    @foreach (var result in results)
                    {
                        var id = result.Text("Id");
                        var lyrics = result.Child("Lyrics");
                        var metadata = lyrics.Child("Metadata");
                        var lines = SubtitleLyricsLogic.LyricLines(lyrics);
                        <div class="listItem listItem-border" data-lyricsid="@id" @key="id">
                            <span class="listItemIcon material-icons lyrics" aria-hidden="true"></span>
                            <div class="listItemBody three-line">
                                <div>@SubtitleLyricsLogic.LyricsTitle(metadata)</div>
                                <div class="secondary listItemBodyText" style="white-space:pre-line;">@(Globalize.Translate("LabelDuration") + ": " + SubtitleLyricsLogic.LyricsDuration(metadata.Number("Length")))</div>
                                <div class="secondary listItemBodyText" style="white-space:pre-line;">@(Globalize.Translate("LabelIsSynced") + ": " + (metadata.Flag("IsSynced") ? "True" : "False"))</div>
                            </div>
                            <IconButton Icon="preview" Class="btnPreview listItemButton" data-lyricsid="@id" OnClick="() => LyricsPreview.ShowAsync(Dialogs, lines)" />
                            <IconButton Icon="file_download" Class="btnDownload listItemButton" data-lyricsid="@id" OnClick="() => DownloadAsync(id)" />
                            <div class="hide hiddenLyrics">
                                <h2>@Globalize["Lyrics"]</h2>
                                <div>@Lines(lines)</div>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>

        <div class="@("noSearchResults" + (_noResults ? null : " hide"))">@Globalize["NoLyricsSearchResultsFound"]</div>
    </div>
</div>

@code {
    private JsonObject? _item;
    private IReadOnlyList<string> _currentLyrics = [];
    private IReadOnlyList<JsonNode?> _results = [];
    private bool _noResults;

    [CascadingParameter]
    public DialogInstance Dialog { get; set; } = default!;

    /// <summary>The id of the song whose lyrics are edited.</summary>
    [Parameter, EditorRequired]
    public string ItemId { get; set; } = string.Empty;

    /// <summary>Told whether lyrics were downloaded, uploaded or deleted.</summary>
    [Parameter]
    public DialogChanges Changes { get; set; } = new();

    /// <summary>
    /// Opens the editor (<c>lyricsEditor.show(itemId, serverId)</c>). True when the lyrics were changed,
    /// which is when the original resolves.
    /// </summary>
    public static async Task<bool> ShowAsync(AppDialogs dialogs, string itemId)
    {
        var changes = new DialogChanges();
        await dialogs.ShowAsync<LyricsEditor>(
            new Dictionary<string, object?>
            {
                [nameof(ItemId)] = itemId,
                [nameof(Changes)] = changes
            },
            new AppDialogOptions { Class = "formDialog lyricsEditorDialog" });
        return changes.HasChanges;
    }

    /// <summary>Lines of lyrics, each followed by a line break (<c>getLyricsText()</c>).</summary>
    internal static RenderFragment Lines(IReadOnlyList<string> lines) => builder =>
    {
        foreach (var line in lines)
        {
            builder.AddContent(0, line);
            builder.AddMarkupContent(1, "<br/>");
        }
    };

    protected override Task OnInitializedAsync() => ReloadAsync();

    // Port of reload() and fillCurrentLyrics(): a song without lyrics answers 404, which empties the list.
    private async Task ReloadAsync()
    {
        _noResults = false;
        Loading.Show();
        try
        {
            _item = await Api.GetItemAsync(ItemId);
        }
        catch (Exception exception) when (ItemDialogApi.IsFailure(exception))
        {
            AppLog.Warn("Loading the song failed: " + exception.Message);
        }

        try
        {
            _currentLyrics = SubtitleLyricsLogic.LyricLines(await Api.GetAsync($"Audio/{ItemId}/Lyrics"));
        }
        catch (Exception exception) when (ItemDialogApi.IsFailure(exception))
        {
            _currentLyrics = [];
        }

        Loading.Hide();
        StateHasChanged();
    }

    // Port of searchForLyrics() and renderSearchResults().
    private async Task SearchAsync()
    {
        Loading.Show();
        try
        {
            _results = [.. await Api.GetArrayAsync($"Audio/{ItemId}/RemoteSearch/Lyrics")];
            _noResults = _results.Count == 0;
        }
        catch (Exception exception) when (ItemDialogApi.IsFailure(exception))
        {
            AppLog.Warn("Searching for lyrics failed: " + exception.Message);
        }
        finally
        {
            Loading.Hide();
        }
    }

    // Port of downloadRemoteLyrics().
    private async Task DownloadAsync(string? id)
    {
        try
        {
            await Api.PostAsync(Api.GetUrl($"Audio/{ItemId}/RemoteSearch/Lyrics/{id}"));
        }
        catch (Exception exception) when (ItemDialogApi.IsFailure(exception))
        {
            AppLog.Warn("Downloading the lyrics failed: " + exception.Message);
            return;
        }

        Changes.HasChanges = true;
        Toasts.Show(Globalize.Translate("MessageDownloadQueued"));
    }

    // Port of onDeleteLyrics() and deleteHelper.deleteLyrics().
    private async Task DeleteAsync()
    {
        var confirmed = await Dialogs.ConfirmAsync(
            Globalize.Translate("ConfirmDeleteLyrics"),
            Globalize.Translate("HeaderDeleteLyrics"),
            Globalize.Translate("Delete"),
            destructive: true);
        if (!confirmed)
        {
            return;
        }

        try
        {
            await Api.DeleteAsync(Api.GetUrl($"Audio/{ItemId}/Lyrics"));
        }
        catch (Exception exception) when (ItemDialogApi.IsFailure(exception))
        {
            AppLog.Warn("Deleting the lyrics failed: " + exception.Message);
            await Dialogs.AlertAsync(Globalize.Translate("ErrorDeletingLyrics"));
            return;
        }

        Changes.HasChanges = true;
        await ReloadAsync();
    }

    private async Task UploadAsync()
    {
        if (await LyricsUploader.ShowAsync(Dialogs, ItemId))
        {
            Changes.HasChanges = true;
            await ReloadAsync();
        }
    }
}
