@namespace Jellyfin.Web.Components
@inject Globalize Globalize

<form class="jf-dashboard-dialog-form" @onsubmit="@(() => Dialog.Close(new BackupOptionsDto { Metadata = _metadata, Subtitles = _subtitles, Trickplay = _trickplay }))" @onsubmit:preventDefault="true">
    <h2 class="jf-dashboard-dialog-title">@Globalize["ButtonCreateBackup"]</h2>
    <div class="jf-dashboard-dialog-content">
        <MudText>@Globalize["MessageBackupDisclaimer"]</MudText>
        <MudCheckBox T="bool" Value="true" Disabled="true" Label="@Globalize["LabelDatabase"]" Class="jf-dashboard-backup-database" />
        <MudCheckBox T="bool" @bind-Value="_metadata" Label="@Globalize["LabelMetadata"]" Class="jf-dashboard-backup-metadata" />
        <MudCheckBox T="bool" @bind-Value="_subtitles" Label="@Globalize["Subtitles"]" Class="jf-dashboard-backup-subtitles" />
        <MudCheckBox T="bool" @bind-Value="_trickplay" Label="@Globalize["Trickplay"]" Class="jf-dashboard-backup-trickplay" />
    </div>
    <div class="jf-dashboard-dialog-actions">
        <MudButton data-id="cancel" OnClick="@(() => Dialog.Cancel())">@Globalize["ButtonCancel"]</MudButton>
        <MudButton data-id="ok" ButtonType="ButtonType.Submit" Color="Color.Primary">@Globalize["Create"]</MudButton>
    </div>
</form>
@code {
    [CascadingParameter] public DialogInstance Dialog { get; set; } = default!;
    private bool _metadata, _subtitles, _trickplay;
}
