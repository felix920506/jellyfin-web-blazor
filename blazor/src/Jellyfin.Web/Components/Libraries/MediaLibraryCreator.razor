@* The "add media library" dialog. Port of components/mediaLibraryCreator. *@
@inject JellyfinApi Api
@inject AppDialogs Dialogs
@inject LoadingService Loading
@inject ToastService Toasts
@inject Globalize Globalize

<div class="formDialogHeader">
    <IconButton Icon="arrow_back" Class="btnCancel autoSize" Title="@Globalize["ButtonBack"]" tabindex="-1" OnClick="() => Dialog.Close(_hasChanges)" />
    <h3 class="formDialogHeaderTitle">@Globalize["ButtonAddMediaLibrary"]</h3>
</div>
<div class="formDialogContent scrollY" style="padding-top:2em;">
    <div class="dialogContentInner dialog-content-centered">
        <form class="addLibraryForm" style="max-width:100%;" @onsubmit="SubmitAsync" @onsubmit:preventDefault="true">
            <div id="fldCollectionType" class="selectContainer">
                <label class="selectLabel" for="selectCollectionType">@Globalize["LabelContentType"]</label>
                <select id="selectCollectionType" class="emby-select-withcolor emby-select" required value="@_type" @onchange="OnTypeChanged">
                    @foreach (var option in CollectionTypeOptions)
                    {
                        <option value="@option.Value">@option.Name</option>
                    }
                </select>
                <div class="selectArrowContainer">
                    <div style="visibility:hidden;display:none;">0</div>
                    <span class="selectArrow material-icons keyboard_arrow_down" aria-hidden="true"></span>
                </div>
                <div class="collectionTypeFieldDescription fieldDescription">@((MarkupString)(_typeMessage ?? string.Empty))</div>
            </div>
            <EmbyInput Id="txtValue" Label="@Globalize["LabelDisplayName"]" Required="true" @bind-Value="_name" />
            <div class="folders">
                <div style="display: flex; align-items: center;">
                    <h1 style="margin: .5em 0;">@Globalize["Folders"]</h1>
                    <button type="button" class="emby-button fab btnAddFolder submit" style="margin-left:1em;" title="@Globalize["Add"]" @onclick="AddFolderAsync">
                        <span class="material-icons add" aria-hidden="true"></span>
                    </button>
                </div>
                <div class="@("paperList folderList" + (_paths.Count == 0 ? " hide" : null))" style="margin-bottom:2em;">
                    @for (var i = 0; i < _paths.Count; i++)
                    {
                        var index = i;
                        <div class="listItem listItem-border lnkPath" style="padding-left:.5em;">
                            <div class="listItemBody">
                                <div class="listItemBodyText" dir="ltr">@_paths[index]</div>
                            </div>
                            <IconButton Icon="remove_circle" Class="listItemButton btnRemovePath" data-index="@index" OnClick="() => RemovePath(index)" />
                        </div>
                    }
                </div>
            </div>
            <div class="@("libraryOptions" + (string.IsNullOrEmpty(_type) ? " hide" : null))">
                <LibraryOptionsEditor @ref="_optionsEditor" ContentType="@_type" />
            </div>
            <div class="formDialogFooter">
                <button type="submit" class="emby-button raised btnSubmit button-submit block formDialogFooterItem">
                    <span>@Globalize["ButtonOk"]</span>
                </button>
            </div>
        </form>
    </div>
</div>

@code {
    private readonly List<string> _paths = [];
    private LibraryOptionsEditor? _optionsEditor;
    private string? _type = string.Empty;
    private string? _typeMessage;
    private string? _name;
    private bool _isCreating;
    private bool _hasChanges;

    [CascadingParameter]
    public DialogInstance Dialog { get; set; } = default!;

    /// <summary>The content types to offer (see <see cref="LibraryUi.GetCollectionTypeOptions"/>).</summary>
    [Parameter]
    public IReadOnlyList<CollectionTypeOption> CollectionTypeOptions { get; set; } = [];

    /// <summary>Whether the server should scan the new library right away.</summary>
    [Parameter]
    public bool Refresh { get; set; }

    /// <summary>Opens the dialog; true when a library was created.</summary>
    public static async Task<bool> ShowAsync(AppDialogs dialogs, IReadOnlyList<CollectionTypeOption> collectionTypeOptions, bool refresh)
    {
        var result = await dialogs.ShowAsync<MediaLibraryCreator>(
            new Dictionary<string, object?>
            {
                [nameof(CollectionTypeOptions)] = collectionTypeOptions,
                [nameof(Refresh)] = refresh
            },
            new AppDialogOptions { Size = "small", Class = "ui-body-a background-theme-a dlg-librarycreator formDialog" });
        return result is true;
    }

    // The query parameter's enum shares its name with the CollectionTypeOptions parameter above.
    private static T? ParseLike<T>(T? current, string? text)
        where T : struct, Enum => EnumText.Parse<T>(text);

    private void OnTypeChanged(ChangeEventArgs args)
    {
        _type = args.Value?.ToString() ?? string.Empty;
        var option = CollectionTypeOptions.FirstOrDefault(o => o.Value == _type);
        if (_type != "mixed")
        {
            // The selected option's text becomes the name (the empty option clears it).
            _name = (option?.Name ?? string.Empty).Replace("*", string.Empty, StringComparison.Ordinal);
        }

        _typeMessage = option?.Message;
    }

    private async Task AddFolderAsync()
    {
        var path = await DirectoryBrowser.ShowAsync(Dialogs);
        if (string.IsNullOrEmpty(path) || _paths.Contains(path))
        {
            return;
        }

        try
        {
            // Only folders the server can read are added; the directory picker reports the others.
            await Api.Client.Environment.DirectoryContents.GetAsync(r => r.QueryParameters.Path = path);
        }
        catch (Exception ex) when (ex is not OperationCanceledException)
        {
            return;
        }

        if (!_paths.Contains(path))
        {
            _paths.Add(path);
        }
    }

    private void RemovePath(int index)
    {
        if (index < 0 || index >= _paths.Count)
        {
            return;
        }

        var location = _paths[index];
        _paths.RemoveAll(p => string.Equals(p, location, StringComparison.OrdinalIgnoreCase));
    }

    private async Task SubmitAsync()
    {
        if (_isCreating)
        {
            return;
        }

        if (_paths.Count == 0)
        {
            await Dialogs.AlertAsync(Globalize["PleaseAddAtLeastOneFolder"]);
            return;
        }

        _isCreating = true;
        Loading.Show();

        var name = (_name ?? string.Empty).Trim();
        if (name.Length == 0)
        {
            _isCreating = false;
            Loading.Hide();
            await Dialogs.AlertAsync(Globalize["LibraryNameInvalid"]);
            return;
        }

        var type = _type == "mixed" ? null : _type;
        var libraryOptions = _optionsEditor?.GetLibraryOptions() ?? new LibraryOptions();
        libraryOptions.PathInfos = _paths.Select(path => new MediaPathInfo { Path = path }).ToList();

        try
        {
            await Api.Client.Library.VirtualFolders.PostAsync(
                new AddVirtualFolderDto { LibraryOptions = libraryOptions },
                request =>
                {
                    request.QueryParameters.CollectionType = ParseLike(request.QueryParameters.CollectionType, type);
                    request.QueryParameters.RefreshLibrary = Refresh;
                    request.QueryParameters.Name = name;
                });
            _hasChanges = true;
            _isCreating = false;
            Loading.Hide();
            Dialog.Close(true);
        }
        catch (Exception ex) when (ex is not OperationCanceledException)
        {
            Toasts.Show(Globalize["ErrorAddingMediaPathToVirtualFolder"]);
            _isCreating = false;
            Loading.Hide();
        }
    }
}
