@* The password section of the profile page. Port of components/dashboard/users/UserPasswordForm. *@
@inject JellyfinApi Api
@inject AppDialogs Dialogs
@inject LoadingService Loading
@inject ToastService Toasts
@inject Globalize Globalize

<div>
    <form class="@("updatePasswordForm passwordSection" + (CanChangePassword ? null : " hide"))" style="margin:0 auto 2em;" @onsubmit="SubmitAsync" @onsubmit:preventDefault="true">
        <div class="detailSection">
            <div id="fldCurrentPassword" class="inputContainer">
                <label class="inputLabel inputLabelUnfocused" for="txtCurrentPassword">@Globalize["LabelCurrentPassword"]</label>
                <input id="txtCurrentPassword" class="emby-input" type="password" autocomplete="off" @bind="_currentPassword" @bind:event="oninput" />
            </div>
            <EmbyInput Id="txtNewPassword" Type="password" Label="@Globalize["LabelNewPassword"]" Autocomplete="off" @bind-Value="_newPassword" />
            <EmbyInput Id="txtNewPasswordConfirm" Type="password" Label="@Globalize["LabelNewPasswordConfirm"]" Autocomplete="off" @bind-Value="_newPasswordConfirm" />
            <br />
            <div>
                <EmbyButton Type="submit" Class="raised button-submit block">
                    <span>@Globalize["SavePassword"]</span>
                </EmbyButton>
                <EmbyButton id="btnResetPassword" Class="@("raised button-cancel block" + (User.Policy?.IsAdministrator == true ? " hide" : null))" OnClick="ResetPasswordAsync">
                    <span>@Globalize["ResetPassword"]</span>
                </EmbyButton>
            </div>
        </div>
    </form>
</div>

@code {
    private string? _currentPassword;
    private string? _newPassword;
    private string? _newPasswordConfirm;

    /// <summary>The user whose password is changed.</summary>
    [Parameter, EditorRequired]
    public UserDto User { get; set; } = default!;

    private bool CanChangePassword => Api.IsAdmin || User.Policy?.EnableUserPreferenceAccess == true;

    private void ClearFields()
    {
        _currentPassword = string.Empty;
        _newPassword = string.Empty;
        _newPasswordConfirm = string.Empty;
    }

    private async Task SubmitAsync()
    {
        var newPassword = _newPassword ?? string.Empty;
        if (newPassword != (_newPasswordConfirm ?? string.Empty))
        {
            Toasts.Show(Globalize["PasswordMatchError"]);
            return;
        }

        if (newPassword.Length == 0 && User.Policy?.IsAdministrator == true)
        {
            Toasts.Show(Globalize["PasswordMissingSaveError"]);
            return;
        }

        Loading.Show();
        try
        {
            await Api.Client.Users.Password.PostAsync(
                new UpdateUserPassword { CurrentPw = _currentPassword ?? string.Empty, NewPw = newPassword },
                request => request.QueryParameters.UserId = User.Id);
        }
        catch (Exception ex) when (ex is not OperationCanceledException)
        {
            Loading.Hide();
            await Dialogs.DashboardAlertAsync(Globalize, Globalize["MessageInvalidUser"], Globalize["HeaderLoginFailure"]);
            return;
        }

        Loading.Hide();
        Toasts.Show(Globalize["PasswordSaved"]);
        ClearFields();
    }

    private async Task ResetPasswordAsync()
    {
        if (!await Dialogs.ConfirmAsync(Globalize["PasswordResetConfirmation"], Globalize["ResetPassword"]))
        {
            return;
        }

        Loading.Show();
        try
        {
            await Api.Client.Users.Password.PostAsync(
                new UpdateUserPassword { ResetPassword = true },
                request => request.QueryParameters.UserId = User.Id);
        }
        catch (Exception ex) when (ex is not OperationCanceledException)
        {
            // The original only logs the failure (and leaves its loading indicator up).
            Loading.Hide();
            AppLog.Warn("[UserPasswordForm] failed to reset user password: " + ex.Message);
            return;
        }

        Loading.Hide();
        ClearFields();
        StateHasChanged();
        await Dialogs.DashboardAlertAsync(Globalize, Globalize["PasswordResetComplete"], Globalize["ResetPassword"]);
    }
}
