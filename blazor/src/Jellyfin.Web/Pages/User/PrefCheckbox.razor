@* A settings checkbox in its .checkboxContainer with the optional description below it. *@
<div class="@ContainerClass">
    <EmbyCheckbox Id="@Id" Class="@Class" Label="@Label" Value="Value" ValueChanged="ValueChanged" />
    @if (Description is not null)
    {
        <div class="fieldDescription checkboxFieldDescription">@Description</div>
    }
    @ChildContent
</div>

@code {
    [Parameter]
    public string? Id { get; set; }

    /// <summary>Classes of the checkbox input.</summary>
    [Parameter]
    public string? Class { get; set; }

    [Parameter]
    public string? Label { get; set; }

    [Parameter]
    public string? Description { get; set; }

    [Parameter]
    public bool Value { get; set; }

    [Parameter]
    public EventCallback<bool> ValueChanged { get; set; }

    [Parameter]
    public string ContainerClass { get; set; } = "checkboxContainer checkboxContainer-withDescription";

    /// <summary>Further descriptions.</summary>
    [Parameter]
    public RenderFragment? ChildContent { get; set; }
}
