@* Legacy server HTML depends on AMD, ApiClient, Dashboard, viewManager and custom elements.
   Resolve it, but never inject/execute it in the Blazor application. *@
@attribute [Route("/configurationpage")]
@attribute [Access(AccessLevel.Admin)]
@layout DashboardLayout
@inject JellyfinApi Api
@inject Globalize Globalize

<Page Id="pluginConfigurationPage" Title="@(_page?.DisplayName ?? Name ?? Globalize["Settings"])" Class="mainAnimatedPage type-interior">
    <div class="content-primary jf-dashboard-plugins">
        @if (_loading) { <DashboardLoading /> }
        else if (_failed) { <MudAlert Severity="Severity.Error">@Globalize["PluginLoadConfigError"]</MudAlert> }
        else if (_page is null) { <MudAlert Severity="Severity.Info">@Globalize["MessageNoPluginConfiguration"]</MudAlert> }
        else
        {
            <MudText Typo="Typo.h1">@(_page.DisplayName ?? _page.Name)</MudText>
            <MudAlert Severity="Severity.Warning" Class="jf-dashboard-plugin-configuration-notice">
                This plugin’s settings page is not available in this client. It requires the legacy Jellyfin web client’s JavaScript APIs. Open the original Jellyfin web client to configure this plugin.
            </MudAlert>
            <MudButton Href="#/dashboard/plugins">@Globalize["TabPlugins"]</MudButton>
        }
    </div>
</Page>

@code {
    [Parameter] public string? Name { get; set; }
    private ConfigurationPageInfo? _page;
    private bool _loading = true, _failed;
    protected override async Task OnParametersSetAsync()
    {
        _loading = true; _failed = false; _page = null;
        try
        {
            var pages = await Api.Client.Web.ConfigurationPages.GetAsync() ?? [];
            _page = pages.FirstOrDefault(p => string.Equals(p.Name, Name, StringComparison.OrdinalIgnoreCase));
            if (_page is not null)
            {
                using var response = await Api.SendAsync(HttpMethod.Get, Api.GetUrl("web/configurationpage", ("name", _page.Name)));
                response.EnsureSuccessStatusCode();
                // Resolve the actual resource so missing/broken settings pages report an error.
                // Do not execute server-provided legacy scripts or insert their HTML.
            }
        }
        catch (Exception ex) when (ex is not OperationCanceledException) { AppLog.Warn("[PluginConfiguration] load failed: " + ex.Message); _failed = true; }
        finally { _loading = false; }
    }
}
