    private async Task ShowSettingsMenuAsync()
    {
        var result = await SettingsMenu.ShowAsync(quality: Playback.CurrentMediaSource?.SupportsTranscoding == true, stats: true);
        ResetIdle();
        if (result == "stats")
        {
            _statsVisible = !_statsVisible;
        }
        else if (result == "suboffset")
        {
            _subtitleSyncVisible = true;
        }
