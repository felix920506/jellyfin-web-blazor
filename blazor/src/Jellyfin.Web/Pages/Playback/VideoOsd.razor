    private void ToggleRemainingTime() => UserSettings.EnableVideoRemainingTime = !UserSettings.EnableVideoRemainingTime;

    private Task SeekPositionAsync(double percent) =>
        Text.LiveTvProgress(Playback.CurrentItem) is not null
            ? Task.CompletedTask
            : Playback.SeekPercentAsync(percent);

    // --- texts and previews ------------------------------------------------------------------------

    /// <summary>The run time, or the time left ("-12:34") when the user prefers that; null hides it.</summary>
    private string? DurationText(long? runtime, long position)
    {
        if (UserSettings.EnableVideoRemainingTime)
        {
            return runtime is { } total && total - position >= 0 ? "-" + Text.RunningTime(total - position) : null;
        }

        return runtime is { } value ? Text.RunningTime(value) : null;
    }

    private string? EndsAtText(BaseItemDto? item, long? runtime, long position) =>
        runtime is { } total && item is { RunTimeTicks: > 0 } && item.Type.ToApiString() != "Recording"
            ? "    " + Text.EndsAt(total, position, Playback.PlaybackRate)
            : null;

    /// <summary>The chapter starts as fractions of the item's run time.</summary>
    private static IReadOnlyList<double>? Markers(BaseItemDto? item)
    {
        if (item is not { Chapters: { Count: > 1 } chapters, RunTimeTicks: > 0 })
        {
            return null;
        }

        var runtime = (double)item.RunTimeTicks.Value;
        return chapters.Select(chapter => (chapter.StartPositionTicks ?? 0) / runtime).ToList();
    }

    /// <summary>The chapter that contains a position.</summary>
    private static (ChapterInfo? Info, int Index) ChapterAt(IReadOnlyList<ChapterInfo>? chapters, long positionTicks)
    {
        ChapterInfo? found = null;
        var index = -1;
        for (var i = 0; i < (chapters?.Count ?? 0); i++)
        {
            if (positionTicks >= (chapters![i].StartPositionTicks ?? 0))
            {
                found = chapters[i];
                index = i;
            }
        }

        return (found, index);
    }

    /// <summary>
    /// The trickplay resolution of what plays: the widest one up to a fifth of the screen's width.
    /// </summary>
    private TrickplayResolution? TrickplayOf(BaseItemDto? item)
    {
        var sourceId = Playback.CurrentMediaSource?.Id;
        if (!ReferenceEquals(item, _trickplayItem) || sourceId != _trickplaySourceId)
        {
            _trickplayItem = item;
            _trickplaySourceId = sourceId;
            var environment = Browser.Environment;
            _trickplay = Trickplay.Select(item, sourceId, environment.ScreenWidth * environment.DevicePixelRatio * 0.2);
        }

        return _trickplay;
    }

    private string TrickplayStyle(BaseItemDto item, TrickplayResolution info, long positionTicks)
    {
        var tile = Trickplay.Tile(info, positionTicks);
        var url = Api.GetUrl(
            $"Videos/{item.Id?.ToString("N")}/Trickplay/{info.Width.ToString(CultureInfo.InvariantCulture)}/{tile.SheetIndex.ToString(CultureInfo.InvariantCulture)}.jpg",
            ("ApiKey", Api.AccessToken),
            ("MediaSourceId", Playback.CurrentMediaSource?.Id));
        return string.Create(
            CultureInfo.InvariantCulture,
            $"overflow:hidden;width:{info.Width}px;height:{info.Height}px;background-image:url('{url}');background-position-x:{tile.OffsetX}px;background-position-y:{tile.OffsetY}px");
    }

    private string? ChapterImageUrl(BaseItemDto item, ChapterInfo chapter, int index)
    {
        if (string.IsNullOrEmpty(chapter.ImageTag))
        {
            return null;
        }

        var id = Playback.CurrentMediaSource?.Id ?? item.Id?.ToString("N");
        return Api.GetUrl($"Items/{id}/Images/Chapter/{index.ToString(CultureInfo.InvariantCulture)}", ("maxWidth", 400), ("tag", chapter.ImageTag));
    }
}
