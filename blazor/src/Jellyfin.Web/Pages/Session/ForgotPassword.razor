@* Starts a password reset. Port of apps/legacy/routes/session/forgotPassword. *@
@attribute [Route("/forgotpassword")]
@attribute [Access(AccessLevel.Public)]
@inject JellyfinApi Api
@inject AppRouter Router
@inject AppDialogs Dialogs
@inject Globalize Globalize
@inject IBrowser Browser

<Page Id="forgotPasswordPage" Class="standalonePage forgotPasswordPage mainAnimatedPage">
    <div class="padded-left padded-right padded-bottom-page">
        <form class="forgotPasswordForm" style="text-align: center; margin: 0 auto;" @onsubmit="SubmitAsync" @onsubmit:preventDefault="true">
            <div style="text-align: left;">
                <h1>@Globalize["ButtonForgotPassword"]</h1>

                <EmbyInput Id="txtName" Label="@Globalize["LabelUser"]" Autocomplete="off" @bind-Value="_username"
                           Description="@Globalize["LabelForgotPasswordUsernameHelp"]" />

                <div>
                    <EmbyButton Type="submit" id="btnSubmit" Class="raised submit block">
                        <span>@Globalize["ButtonSubmit"]</span>
                    </EmbyButton>

                    <EmbyButton id="btnCancel" Class="raised cancel block btnCancel" OnClick="Router.Back">
                        <span>@Globalize["ButtonCancel"]</span>
                    </EmbyButton>
                </div>
            </div>
        </form>
    </div>
</Page>

@code {
    private string? _username;

    private async Task SubmitAsync()
    {
        ForgotPasswordResult? result;
        try
        {
            result = await Api.Client.Users.ForgotPassword.PostAsync(new ForgotPasswordDto { EnteredUsername = _username ?? string.Empty });
        }
        catch (Exception ex)
        {
            AppLog.Warn($"[ForgotPasswordPage] request failed: {ex.Message}");
            return;
        }

        if (result is null)
        {
            return;
        }

        string message;
        string? next = null;
        switch (result.Action.ToApiString())
        {
            case "ContactAdmin":
                message = Globalize["MessageContactAdminToResetPassword"];
                break;
            case "InNetworkRequired":
                message = Globalize["MessageForgotPasswordInNetworkRequired"];
                break;
            case "PinCode":
                if (SessionUi.IsValidUrl(result.PinFile))
                {
                    message = Globalize["MessageForgotPasswordRedirect"];
                    Browser.OpenUrl(result.PinFile!);
                    next = "/login";
                }
                else
                {
                    message = Globalize["MessageForgotPasswordFileCreated"]
                        + "<br/><br/>"
                        + Globalize["MessageForgotPasswordPinReset"]
                        + "<br/><br/>"
                        + SessionUi.HtmlEncode(result.PinFile)
                        + "<br/>";
                    next = "/forgotpasswordpin";
                }

                break;
            default:
                return;
        }

        await Dialogs.AlertHtmlAsync(Globalize, message, Globalize["ButtonForgotPassword"]);
        if (next is not null)
        {
            Router.Navigate(next);
        }
    }
}
