@* Redeems a password reset PIN. Port of apps/legacy/controllers/session/resetPassword. *@
@attribute [Route("/forgotpasswordpin")]
@attribute [Access(AccessLevel.Public)]
@inject JellyfinApi Api
@inject AppRouter Router
@inject AppDialogs Dialogs
@inject Globalize Globalize

<Page Id="forgotPasswordPinPage" Class="standalonePage forgotPasswordPinPage mainAnimatedPage">
    <div class="padded-left padded-right padded-bottom-page">
        <form class="forgotPasswordPinForm" style="text-align: center; margin: 0 auto;" @onsubmit="SubmitAsync" @onsubmit:preventDefault="true">
            <div style="text-align: left;">
                <h2>@Globalize["HeaderPasswordReset"]</h2>

                <EmbyInput @ref="_pinInput" Id="txtPin" Label="@Globalize["LabelPasswordRecoveryPinCode"]" Autocomplete="off" Required="true" @bind-Value="_pin" />

                <div>
                    <EmbyButton Type="submit" Class="raised submit block">
                        <span>@Globalize["ButtonSubmit"]</span>
                    </EmbyButton>

                    <EmbyButton Class="raised cancel block btnCancel" OnClick="Router.Back">
                        <span>@Globalize["ButtonCancel"]</span>
                    </EmbyButton>
                </div>
            </div>
        </form>
    </div>
</Page>

@code {
    private EmbyInput? _pinInput;
    private string? _pin;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && _pinInput is not null)
        {
            try
            {
                await _pinInput.Element.FocusAsync();
            }
            catch (Exception)
            {
                // Navigated away before the element could take focus.
            }
        }
    }

    private async Task SubmitAsync()
    {
        PinRedeemResult? result;
        try
        {
            result = await Api.Client.Users.ForgotPassword.Pin.PostAsync(new ForgotPasswordPinDto { Pin = _pin ?? string.Empty });
        }
        catch (Exception ex)
        {
            AppLog.Warn($"[ForgotPasswordPinPage] request failed: {ex.Message}");
            return;
        }

        if (result?.Success == true)
        {
            var message = Globalize["MessagePasswordResetForUsers"]
                + "<br/><br/>"
                + string.Join("<br/>", (result.UsersReset ?? []).Select(SessionUi.HtmlEncode));
            await Dialogs.AlertHtmlAsync(Globalize, message, Globalize["HeaderPasswordReset"]);

            // The original sets window.location.href = '': back to the start of the app.
            Router.Navigate("/");
            return;
        }

        await Dialogs.AlertAsync(Globalize["MessageInvalidForgotPasswordPin"], Globalize["HeaderPasswordReset"]);
    }
}
