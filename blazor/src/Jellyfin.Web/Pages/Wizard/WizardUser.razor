@* Startup wizard, step 2: the administrator account. Port of apps/wizard/controllers/user. *@
@attribute [Route("/wizard/user")]
@attribute [Access(AccessLevel.Wizard)]
@inject JellyfinApi Api
@inject AppRouter Router
@inject LoadingService Loading
@inject ToastService Toasts
@inject Globalize Globalize

<Page Id="wizardUserPage" Class="standalonePage wizardPage">
    <div class="padded-left padded-right padded-top">
        <div class="ui-corner-all ui-shadow wizardContent">
            <form class="wizardUserForm" @onsubmit="SubmitAsync" @onsubmit:preventDefault="true">
                <div class="verticalSection">
                    <h1 class="sectionTitle">@Globalize["TellUsAboutYourself"]</h1>
                    <p style="margin-top:2em;">@Globalize["UserProfilesIntro"]</p>
                    <br />
                    <EmbyInput Id="txtUsername" Label="@Globalize["LabelUsername"]" Required="true" Description="@Globalize["SelectAdminUsername"]"
                               @bind-Value="_username" />
                    <EmbyInput Id="txtManualPassword" Type="password" Label="@Globalize["LabelPassword"]" Required="true"
                               Description="@Globalize["PasswordRequiredForAdmin"]" @bind-Value="_password" />
                    <EmbyInput Id="txtPasswordConfirm" Type="password" Label="@Globalize["LabelPasswordConfirm"]" Required="true"
                               @bind-Value="_passwordConfirm" />
                    <p>@Globalize["MoreUsersCanBeAddedLater"]</p>
                </div>
                <div class="wizardNavigation">
                    <EmbyButton Class="raised button-cancel" OnClick="Router.Back">
                        <span class="material-icons arrow_back" aria-hidden="true"></span>
                        <span>@Globalize["Previous"]</span>
                    </EmbyButton>
                    <EmbyButton Type="submit" Class="raised button-submit">
                        <span>@Globalize["Next"]</span>
                        <span class="material-icons arrow_forward" aria-hidden="true"></span>
                    </EmbyButton>
                </div>
            </form>
        </div>
    </div>
</Page>

@code {
    // The startup endpoints are marked deprecated in the API description; the wizard still uses them.
#pragma warning disable CS0618
    private string? _username;
    private string? _password;
    private string? _passwordConfirm;

    protected override async Task OnInitializedAsync()
    {
        Loading.Show();
        try
        {
            var user = await Api.Client.Startup.User.GetAsync();
            _username = user?.Name ?? string.Empty;
            _password = user?.Password ?? string.Empty;
            Loading.Hide();
        }
        catch (Exception ex) when (ex is not OperationCanceledException)
        {
            // The original leaves the loading indicator up when the request fails.
            AppLog.Warn("Loading the first user failed: " + ex.Message);
        }
    }

    private async Task SubmitAsync()
    {
        if ((_password ?? string.Empty) != (_passwordConfirm ?? string.Empty))
        {
            Toasts.Show(Globalize["PasswordMatchError"]);
            return;
        }

        Loading.Show();
        try
        {
            await Api.Client.Startup.User.PostAsync(new StartupUserDto
            {
                Name = (_username ?? string.Empty).Trim(),
                Password = _password ?? string.Empty
            });
            Loading.Hide();
            Router.Navigate("/wizard/library");
        }
        catch (Exception ex) when (ex is not OperationCanceledException)
        {
            Toasts.Show(Globalize["ErrorDefault"]);
            Loading.Hide();
        }
    }
#pragma warning restore CS0618
}
