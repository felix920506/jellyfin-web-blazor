@* Startup wizard, last step. Port of apps/wizard/controllers/finish. *@
@attribute [Route("/wizard/finish")]
@attribute [Access(AccessLevel.Wizard)]
@inject JellyfinApi Api
@inject AppRouter Router
@inject LoadingService Loading
@inject Globalize Globalize

<Page Id="wizardFinishPage" Class="standalonePage wizardPage">
    <div class="padded-left padded-right padded-top">
        <div class="ui-corner-all ui-shadow wizardContent">
            <h1>@Globalize["LabelYoureDone"]</h1>
            <p style="margin:2em 0;">@Globalize["WizardCompleted"]</p>
            <div class="wizardNavigation">
                <EmbyButton Class="raised button-cancel" OnClick="Router.Back">
                    <span class="material-icons arrow_back" aria-hidden="true"></span>
                    <span>@Globalize["Previous"]</span>
                </EmbyButton>
                <EmbyButton Class="raised btnWizardNext button-submit" OnClick="FinishAsync">
                    <span class="material-icons check" aria-hidden="true"></span>
                    <span>@Globalize["LabelFinish"]</span>
                </EmbyButton>
            </div>
        </div>
    </div>
</Page>

@code {
    private async Task FinishAsync()
    {
        Loading.Show();
        try
        {
            await Api.Client.Startup.Complete.PostAsync();
            Loading.Hide();

            // The original reloads the app at its root; the router takes it from there (sign-in).
            Router.Navigate("/");
        }
        catch (Exception ex) when (ex is not OperationCanceledException)
        {
            AppLog.Warn("Completing the startup wizard failed: " + ex.Message);
        }
    }
}
